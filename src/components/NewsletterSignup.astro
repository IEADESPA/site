---
import { siteConfig } from "@/config/site";
import { DIRECTUS_URL } from "@/lib/directus";

/*
 * The compact subscribe form used once, in the home sidebar under the About
 * blurb. Monograph deliberately keeps a single signup point rather than
 * repeating a call to action at the end of every page.
 */
const newsletter = siteConfig.newsletter;
const isEnabled = newsletter.enabled;
---

<section id="newsletter" aria-labelledby="newsletter-heading">
  <h3 id="newsletter-heading" class="text-base font-semibold tracking-tight">{newsletter.title}</h3>
  <p class="mt-2 text-pretty text-sm leading-relaxed text-muted-foreground">{newsletter.description}</p>

  <form class="mt-5 grid gap-3" data-newsletter-form={isEnabled ? "" : undefined}>
    <label class="sr-only" for="newsletter-email">Endereço de e-mail</label>
    <input
      id="newsletter-email"
      required
      type="email"
      name="email"
      autocomplete="email"
      placeholder="voce@exemplo.com"
      disabled={!isEnabled}
      class="field"
    />
    <button type="submit" disabled={!isEnabled} class="btn btn-solid btn-block">
      {isEnabled ? "Inscrever-se" : "Em breve"}
    </button>
    <p
      class="newsletter-status text-xs leading-relaxed text-muted-foreground"
      role="status"
      aria-live="polite"
      data-newsletter-status
    >
    </p>
    {!isEnabled && (
      <p class="text-xs leading-relaxed text-muted-foreground">
        A inscrição está desativada até que um provedor de e-mail seja configurado.
      </p>
    )}
  </form>
</section>

{
  isEnabled && (
    <script is:inline define:vars={{ directusUrl: DIRECTUS_URL }}>
      document.querySelectorAll("[data-newsletter-form]").forEach((form) => {
        form.addEventListener("submit", async (event) => {
          event.preventDefault();
          const status = form.querySelector("[data-newsletter-status]");
          const button = form.querySelector("button[type=submit]");
          const email = new FormData(form).get("email");

          if (button) button.disabled = true;
          if (status) status.textContent = "Enviando…";

          try {
            const response = await fetch(`${directusUrl}/items/newsletter_assinantes`, {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ email }),
            });

            if (response.ok) {
              if (status) status.textContent = "Inscrito! Você vai receber nossos avisos por e-mail.";
              form.reset();
            } else {
              const body = await response.json().catch(() => null);
              const alreadySubscribed = body?.errors?.some((e) => e.extensions?.code === "RECORD_NOT_UNIQUE");
              if (status) {
                status.textContent = alreadySubscribed
                  ? "Este e-mail já está inscrito."
                  : "Não foi possível concluir agora. Tente novamente em instantes.";
              }
              if (alreadySubscribed) form.reset();
            }
          } catch {
            if (status) status.textContent = "Não foi possível concluir agora. Tente novamente em instantes.";
          } finally {
            if (button) button.disabled = false;
          }
        });
      });
    </script>
  )
}

<style>
  .newsletter-status:empty {
    display: none;
  }
</style>
