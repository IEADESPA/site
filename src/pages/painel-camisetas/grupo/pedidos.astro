---
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { DIRECTUS_URL } from "@/lib/directus";
import { getAllMensagens, visiblePosts } from "@/lib/posts";

const allPosts = visiblePosts(await getAllMensagens());
---

<BaseLayout title="Pedidos e lotes de compra — Gestão de camisetas" description="Área restrita da equipe." noindex>
  <SiteHeader posts={allPosts} />
  <main id="content" class="outer">
    <div class="canvas" data-directus-url={DIRECTUS_URL}>
      <header class="pagehead">
        <p class="eyebrow"><a href="/painel-camisetas/" class="text-accent">← Gestão de camisetas</a></p>
        <h1 class="pagehead-title" data-painel-titulo>Pedidos e lotes de compra</h1>
        <p class="pagehead-description" data-painel-carregando>Verificando sua sessão…</p>
      </header>

      <div hidden data-painel-erro class="gallery-empty mt-8">
        <p class="text-sm text-muted-foreground">Não encontrado.</p>
      </div>

      <div hidden data-painel-conteudo>
        <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4" data-stats-grid>
          <div class="stat-card"><p class="stat-numero" data-stat="total">0</p><p class="stat-label">Pedidos</p></div>
          <div class="stat-card"><p class="stat-numero" data-stat="arrecadado">R$ 0</p><p class="stat-label">Arrecadado</p></div>
          <div class="stat-card"><p class="stat-numero" data-stat="esperado">R$ 0</p><p class="stat-label">Esperado (total)</p></div>
          <div class="stat-card"><p class="stat-numero" data-stat="lucro">R$ 0</p><p class="stat-label">Lucro estimado</p></div>
        </div>
        <p class="mt-2 text-xs text-muted-foreground">
          Lucro estimado usa o custo médio por peça entre os lotes de compra já lançados (o custo
          real pode variar peça a peça, já que o preço muda de encomenda pra encomenda).
        </p>

        <div class="mt-8 grid gap-6 lg:grid-cols-2">
          <div>
            <h2 class="section-title">Por tamanho/modelo</h2>
            <p class="mt-1 text-sm text-muted-foreground">Pedido = quantidade pedida (sem contar venda avulsa, que já sai de estoque existente).</p>
            <div class="mt-3 overflow-x-auto">
              <table class="tabela-camiseta">
                <thead><tr><th>Tamanho</th><th>Modelo</th><th>Pedido</th><th>Recebido (lotes)</th><th>Falta encomendar</th></tr></thead>
                <tbody data-tamanhos-corpo></tbody>
              </table>
            </div>
          </div>
          <div>
            <h2 class="section-title">Por congregação</h2>
            <div class="mt-3 flex flex-wrap gap-2" data-congregacoes-resumo></div>
          </div>
        </div>

        <div class="mt-8">
          <h2 class="section-title">Lotes de compra</h2>
          <p class="mt-1 text-sm text-muted-foreground">
            Cada encomenda feita ao fornecedor vira um lote de compra aqui, com seu próprio custo —
            não precisa esperar todos os lotes chegarem pra começar a entregar.
          </p>
          <div class="mt-4 overflow-x-auto">
            <table class="tabela-camiseta">
              <thead><tr><th>Tamanho</th><th>Modelo</th><th>Quantidade</th><th>Custo/peça</th><th></th></tr></thead>
              <tbody data-lotes-corpo></tbody>
            </table>
          </div>
          <div class="mt-4 grid gap-2 sm:grid-cols-[1fr_1fr_auto_auto_auto] max-w-2xl" data-lote-novo>
            <input type="text" class="field" placeholder="Tamanho" data-novo-lote-tamanho />
            <input type="text" class="field" placeholder="Modelo" data-novo-lote-modelo />
            <input type="number" min="0" class="field" placeholder="Qtd" style="width:6rem" data-novo-lote-quantidade />
            <input type="number" step="0.01" min="0" class="field" placeholder="Custo/peça" style="width:7rem" data-novo-lote-custo />
            <button type="button" class="btn btn-outline" data-adicionar-lote>Adicionar</button>
          </div>
        </div>

        <div class="mt-8 flex flex-wrap items-baseline justify-between gap-3">
          <h2 class="section-title">Todos os pedidos</h2>
          <button type="button" class="btn btn-solid" data-abrir-avulso>+ Venda avulsa</button>
        </div>

        <div hidden class="mt-4 grid gap-3 max-w-lg" data-avulso-form-wrap>
          <div class="grid gap-2">
            <label class="text-sm font-semibold">Nome (opcional)</label>
            <input type="text" class="field" data-avulso-nome />
          </div>
          <div class="grid gap-2">
            <label class="text-sm font-semibold">Valor já pago</label>
            <input type="number" step="0.01" min="0" class="field" value="0" data-avulso-valor-pago />
          </div>
          <fieldset class="grid gap-2">
            <legend class="text-sm font-semibold">Itens</legend>
            <div class="grid gap-2" data-avulso-itens></div>
            <button type="button" class="btn btn-outline mt-1" data-avulso-item-adicionar>+ Adicionar item</button>
          </fieldset>
          <div class="flex items-center gap-4">
            <button type="button" class="btn btn-solid" data-avulso-salvar>Registrar venda avulsa</button>
            <p class="text-sm" data-avulso-status role="status" aria-live="polite"></p>
          </div>
          <p class="text-xs text-muted-foreground">
            Venda avulsa não entra na contagem de "falta encomendar" — o entendimento é que essa
            peça já saiu de um lote de compra existente, não gerou uma encomenda nova.
          </p>
        </div>

        <div class="mt-6 flex flex-wrap items-center gap-3">
          <input type="search" class="field busca-input" placeholder="Buscar por nome…" data-busca />
          <div class="flex flex-wrap gap-2" data-filtros>
            <button type="button" class="filtro-chip is-active" data-filtro="todos">Todos</button>
            <button type="button" class="filtro-chip" data-filtro="devendo">Devendo</button>
            <button type="button" class="filtro-chip" data-filtro="pago">Pago</button>
            <button type="button" class="filtro-chip" data-filtro="pendente-retirada">Com peça a retirar</button>
            <button type="button" class="filtro-chip" data-filtro="retirado">Já retirado tudo</button>
          </div>
        </div>

        <div class="mt-4 flex flex-wrap items-center gap-3" data-filtro-pergunta-bloco hidden>
          <span class="text-sm font-semibold text-muted-foreground">Filtrar por pergunta:</span>
          <select class="field" data-filtro-pergunta-select></select>
          <select class="field" data-filtro-pergunta-valor hidden></select>
          <button type="button" class="link-sweep text-accent text-sm font-semibold" data-filtro-pergunta-limpar hidden>
            Limpar filtro
          </button>
        </div>

        <div class="mt-4 grid gap-4" data-pedidos-lista></div>
      </div>
    </div>
  </main>
  <SiteFooter />

  <script>
    import { exigirAutenticacao } from "@/lib/painelAuth";

    const AUTH = { tokenKey: "painel_camisetas_token", loginPath: "/painel-camisetas/entrar/" };

    interface Grupo {
      id: number;
      nome: string;
      valor_venda: number | null;
      tamanhos: string[] | null;
      modelos: string[] | null;
    }

    interface Item {
      id: number;
      tamanho: string | null;
      modelo: string | null;
      quantidade: number;
      quantidade_retirada: number;
    }

    interface Pedido {
      id: number;
      nome: string;
      congregacao: { name: string } | null;
      valor_pago: number;
      avulso: boolean;
      itens: Item[];
    }

    interface LoteCompra {
      id: number;
      tamanho: string | null;
      modelo: string | null;
      quantidade: number;
      valor_custo: number | null;
    }

    type TipoPergunta = "texto_curto" | "texto_longo" | "selecao_unica" | "selecao_multipla" | "numero" | "data";

    interface Pergunta {
      id: number;
      ordem: number | null;
      label: string;
      tipo: TipoPergunta;
      opcoes: string[] | null;
    }

    interface Resposta {
      pedido: number;
      pergunta: number;
      valor: string;
    }

    const container = document.querySelector<HTMLElement>("[data-directus-url]");
    if (!container) throw new Error("contêiner do painel ausente");
    const directusUrl = container.dataset.directusUrl ?? "";

    const idParam = new URLSearchParams(window.location.search).get("id");
    const grupoId = idParam ? Number(idParam) : null;

    const carregando = document.querySelector<HTMLElement>("[data-painel-carregando]");
    const erroEl = document.querySelector<HTMLElement>("[data-painel-erro]");
    const conteudoEl = document.querySelector<HTMLElement>("[data-painel-conteudo]");
    const tituloEl = document.querySelector<HTMLElement>("[data-painel-titulo]");
    const listaEl = document.querySelector<HTMLElement>("[data-pedidos-lista]");
    const tamanhosCorpoEl = document.querySelector<HTMLElement>("[data-tamanhos-corpo]");
    const congregacoesResumoEl = document.querySelector<HTMLElement>("[data-congregacoes-resumo]");
    const lotesCorpoEl = document.querySelector<HTMLElement>("[data-lotes-corpo]");

    let token = "";
    let grupo: Grupo;
    let pedidos: Pedido[] = [];
    let lotesCompra: LoteCompra[] = [];
    let perguntas: Pergunta[] = [];
    let respostasPorPedido = new Map<number, Resposta[]>();
    let filtroAtivo: "todos" | "devendo" | "pago" | "pendente-retirada" | "retirado" = "todos";
    let termoBusca = "";
    let filtroPerguntaId: number | null = null;
    let filtroPerguntaValor: string | null = null;

    function escapeHtml(value: string) {
      return String(value).replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c] ?? c);
    }
    const brl = (v: number) => `R$ ${v.toLocaleString("pt-BR", { minimumFractionDigits: 2 })}`;

    function totalItens(p: Pedido): number {
      return p.itens.reduce((s, i) => s + i.quantidade, 0);
    }
    function totalPedido(p: Pedido): number {
      return totalItens(p) * (grupo.valor_venda ?? 0);
    }
    function devendo(p: Pedido): boolean {
      return Number(p.valor_pago) < totalPedido(p);
    }
    function custoMedioPorPeca(): number {
      const totalQtd = lotesCompra.reduce((s, l) => s + l.quantidade, 0);
      if (totalQtd === 0) return 0;
      const totalCusto = lotesCompra.reduce((s, l) => s + l.quantidade * Number(l.valor_custo ?? 0), 0);
      return totalCusto / totalQtd;
    }
    function temPendenteRetirada(p: Pedido): boolean {
      let restante = (grupo.valor_venda ?? 0) > 0 ? Number(p.valor_pago) / Number(grupo.valor_venda) : 0;
      for (const item of p.itens) {
        const paga = Math.max(0, Math.min(item.quantidade, Math.floor(restante)));
        restante -= paga;
        if (item.quantidade_retirada < paga) return true;
      }
      return false;
    }
    function tudoRetirado(p: Pedido): boolean {
      return p.itens.length > 0 && p.itens.every((item) => item.quantidade_retirada >= item.quantidade);
    }

    function atualizarStats() {
      const stat = (nome: string) => document.querySelector<HTMLElement>(`[data-stat="${nome}"]`);
      const venda = grupo.valor_venda ?? 0;
      const custoMedio = custoMedioPorPeca();

      const arrecadado = pedidos.reduce((s, p) => s + Number(p.valor_pago || 0), 0);
      const totalPecas = pedidos.reduce((s, p) => s + totalItens(p), 0);
      const esperado = totalPecas * venda;
      const lucro = totalPecas * (venda - custoMedio);

      const t = stat("total"); if (t) t.textContent = String(pedidos.length);
      const a = stat("arrecadado"); if (a) a.textContent = brl(arrecadado);
      const e = stat("esperado"); if (e) e.textContent = brl(esperado);
      const l = stat("lucro"); if (l) l.textContent = brl(lucro);

      if (tamanhosCorpoEl) {
        const chave = (t: string | null, m: string | null) => `${t ?? "—"}|||${m ?? "—"}`;
        const pedidoPorCombo = new Map<string, number>();
        pedidos.forEach((p) => {
          if (p.avulso) return; // avulso não conta como "precisa encomendar"
          p.itens.forEach((item) => {
            const k = chave(item.tamanho, item.modelo);
            pedidoPorCombo.set(k, (pedidoPorCombo.get(k) ?? 0) + item.quantidade);
          });
        });
        const recebidoPorCombo = new Map<string, number>();
        lotesCompra.forEach((l) => recebidoPorCombo.set(chave(l.tamanho, l.modelo), (recebidoPorCombo.get(chave(l.tamanho, l.modelo)) ?? 0) + l.quantidade));

        const combos = new Set([...pedidoPorCombo.keys(), ...recebidoPorCombo.keys()]);
        tamanhosCorpoEl.innerHTML = combos.size
          ? Array.from(combos)
              .sort()
              .map((k) => {
                const [tamanho, modelo] = k.split("|||");
                const pedido = pedidoPorCombo.get(k) ?? 0;
                const recebido = recebidoPorCombo.get(k) ?? 0;
                const falta = Math.max(0, pedido - recebido);
                return `<tr><td>${escapeHtml(tamanho)}</td><td>${escapeHtml(modelo)}</td><td>${pedido}</td><td>${recebido}</td><td>${falta}</td></tr>`;
              })
              .join("")
          : `<tr><td colspan="5" class="text-sm text-muted-foreground">Nenhum pedido ainda.</td></tr>`;
      }

      if (congregacoesResumoEl) {
        const contagem = new Map<string, number>();
        pedidos.forEach((p) => {
          const nome = p.congregacao?.name ?? "Não informada";
          contagem.set(nome, (contagem.get(nome) ?? 0) + totalItens(p));
        });
        congregacoesResumoEl.innerHTML =
          Array.from(contagem.entries())
            .sort((a, b) => b[1] - a[1])
            .map(([nome, qtd]) => `<span class="tamanho-chip">${escapeHtml(nome)}: <strong>${qtd}</strong></span>`)
            .join("") || `<span class="text-sm text-muted-foreground">Nenhum pedido ainda.</span>`;
      }
    }

    function renderizarLotesCompra() {
      if (!lotesCorpoEl) return;
      lotesCorpoEl.innerHTML = lotesCompra.length
        ? lotesCompra
            .map(
              (l) => `
                <tr data-lote-id="${l.id}">
                  <td>${escapeHtml(l.tamanho ?? "—")}</td>
                  <td>${escapeHtml(l.modelo ?? "—")}</td>
                  <td><input type="number" min="0" class="field" style="width:6rem" value="${l.quantidade}" data-campo-quantidade /></td>
                  <td><input type="number" step="0.01" min="0" class="field" style="width:7rem" value="${l.valor_custo ?? 0}" data-campo-custo /></td>
                  <td class="flex gap-3">
                    <button type="button" class="link-sweep text-sm font-semibold text-accent" data-salvar-lote>Salvar</button>
                    <button type="button" class="link-sweep text-sm font-semibold" data-excluir-lote>Excluir</button>
                  </td>
                </tr>
              `,
            )
            .join("")
        : `<tr><td colspan="5" class="text-sm text-muted-foreground">Nenhum lote de compra lançado ainda.</td></tr>`;
    }

    function itemLinhaHtml(i: Item, quantidadePaga: number): string {
      const rotulo = [i.tamanho, i.modelo].filter((v): v is string => Boolean(v)).map(escapeHtml).join(" · ") || "Item";
      return `
        <li class="flex flex-wrap items-center gap-3 justify-between" data-item-id="${i.id}">
          <span>${rotulo} — ${i.quantidade}x (${quantidadePaga} paga${quantidadePaga === 1 ? "" : "s"})</span>
          <span class="flex items-center gap-2 text-sm">
            Retiradas:
            <input type="number" min="0" max="${Math.min(i.quantidade, quantidadePaga)}" value="${i.quantidade_retirada}" class="field" style="width:4.5rem" data-campo-retirada />
            <button type="button" class="link-sweep text-sm font-semibold text-accent" data-salvar-item>Salvar</button>
          </span>
        </li>
      `;
    }

    function pedidoCardHtml(p: Pedido): string {
      let restante = (grupo.valor_venda ?? 0) > 0 ? Number(p.valor_pago) / Number(grupo.valor_venda) : 0;
      const itensHtml = p.itens
        .map((item) => {
          const paga = Math.max(0, Math.min(item.quantidade, Math.floor(restante)));
          restante -= paga;
          return itemLinhaHtml(item, paga);
        })
        .join("");

      return `
        <div class="camiseta-pedido-painel-card" data-pedido-id="${p.id}">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <div>
              <p class="font-semibold">${escapeHtml(p.nome)} ${p.avulso ? '<span class="badge-avulso">venda avulsa</span>' : ""}</p>
              <p class="text-xs text-muted-foreground">${escapeHtml(p.congregacao?.name ?? "Congregação não informada")}</p>
            </div>
            <div class="flex items-center gap-3">
              <label class="text-sm">Pago: R$
                <input type="number" step="0.01" min="0" class="field" style="width:6.5rem" value="${p.valor_pago}" data-campo-valor-pago />
              </label>
              <button type="button" class="link-sweep text-sm font-semibold text-accent" data-salvar-pedido>Salvar</button>
              <button type="button" class="link-sweep text-sm font-semibold" data-excluir-pedido>Excluir</button>
            </div>
          </div>
          <ul class="mt-3 grid gap-2">${itensHtml}</ul>
        </div>
      `;
    }

    function renderizarPedidos() {
      if (!listaEl) return;
      const termo = termoBusca.trim().toLowerCase();
      const filtrados = pedidos.filter((p) => {
        if (termo && !p.nome.toLowerCase().includes(termo)) return false;
        if (filtroPerguntaId !== null) {
          const respostas = respostasPorPedido.get(p.id) ?? [];
          const resposta = respostas.find((r) => r.pergunta === filtroPerguntaId);
          const valores = (resposta?.valor ?? "")
            .split(",")
            .map((v) => v.trim())
            .filter(Boolean);
          if (!valores.includes(filtroPerguntaValor ?? "")) return false;
        }
        if (filtroAtivo === "devendo") return devendo(p);
        if (filtroAtivo === "pago") return !devendo(p);
        if (filtroAtivo === "pendente-retirada") return temPendenteRetirada(p);
        if (filtroAtivo === "retirado") return tudoRetirado(p);
        return true;
      });
      listaEl.innerHTML = filtrados.length ? filtrados.map(pedidoCardHtml).join("") : `<p class="text-sm text-muted-foreground">Nenhum pedido nesse filtro.</p>`;
    }

    document.querySelectorAll<HTMLButtonElement>("[data-filtro]").forEach((botao) => {
      botao.addEventListener("click", () => {
        filtroAtivo = botao.dataset.filtro as typeof filtroAtivo;
        document.querySelectorAll("[data-filtro]").forEach((b) => b.classList.toggle("is-active", b === botao));
        renderizarPedidos();
      });
    });

    const buscaInput = document.querySelector<HTMLInputElement>("[data-busca]");
    buscaInput?.addEventListener("input", () => {
      termoBusca = buscaInput.value;
      renderizarPedidos();
    });

    function perguntasComOpcoes(): Pergunta[] {
      return perguntas.filter((p) => p.tipo === "selecao_unica" || p.tipo === "selecao_multipla");
    }

    function renderizarFiltroPergunta() {
      const bloco = document.querySelector<HTMLElement>("[data-filtro-pergunta-bloco]");
      const selectPergunta = document.querySelector<HTMLSelectElement>("[data-filtro-pergunta-select]");
      const selectValor = document.querySelector<HTMLSelectElement>("[data-filtro-pergunta-valor]");
      const limparBtn = document.querySelector<HTMLButtonElement>("[data-filtro-pergunta-limpar]");
      if (!bloco || !selectPergunta || !selectValor || !limparBtn) return;

      const graficaveis = perguntasComOpcoes();
      bloco.hidden = graficaveis.length === 0;
      if (!graficaveis.length) return;

      if (!selectPergunta.dataset.montado) {
        selectPergunta.dataset.montado = "1";
        selectPergunta.innerHTML =
          `<option value="">Nenhuma</option>` + graficaveis.map((p) => `<option value="${p.id}">${escapeHtml(p.label)}</option>`).join("");

        selectPergunta.addEventListener("change", () => {
          const perguntaId = selectPergunta.value ? Number(selectPergunta.value) : null;
          filtroPerguntaId = perguntaId;
          filtroPerguntaValor = null;
          const pergunta = perguntaId ? graficaveis.find((p) => p.id === perguntaId) : null;
          if (pergunta) {
            selectValor.innerHTML = (pergunta.opcoes ?? []).map((o) => `<option value="${escapeHtml(o)}">${escapeHtml(o)}</option>`).join("");
            selectValor.hidden = false;
            filtroPerguntaValor = pergunta.opcoes?.[0] ?? null;
            limparBtn.hidden = false;
          } else {
            selectValor.hidden = true;
            limparBtn.hidden = true;
          }
          renderizarPedidos();
        });

        selectValor.addEventListener("change", () => {
          filtroPerguntaValor = selectValor.value;
          renderizarPedidos();
        });

        limparBtn.addEventListener("click", () => {
          selectPergunta.value = "";
          filtroPerguntaId = null;
          filtroPerguntaValor = null;
          selectValor.hidden = true;
          limparBtn.hidden = true;
          renderizarPedidos();
        });
      }
    }

    // --- lotes de compra ---
    document.querySelector("[data-adicionar-lote]")?.addEventListener("click", async () => {
      const tamanho = (document.querySelector<HTMLInputElement>("[data-novo-lote-tamanho]")?.value ?? "").trim();
      const modelo = (document.querySelector<HTMLInputElement>("[data-novo-lote-modelo]")?.value ?? "").trim();
      const quantidade = Number(document.querySelector<HTMLInputElement>("[data-novo-lote-quantidade]")?.value || 0);
      const valorCusto = Number(document.querySelector<HTMLInputElement>("[data-novo-lote-custo]")?.value || 0);
      if (!quantidade) return;

      const res = await fetch(`${directusUrl}/items/camiseta_lotes`, {
        method: "POST",
        headers: { Authorization: `Bearer ${token}`, "Content-Type": "application/json" },
        body: JSON.stringify({ grupo: grupoId, tamanho: tamanho || null, modelo: modelo || null, quantidade, valor_custo: valorCusto }),
      });
      if (res.ok) {
        const novo = (await res.json()).data;
        lotesCompra.push(novo);
        renderizarLotesCompra();
        atualizarStats();
      }
    });

    lotesCorpoEl?.addEventListener("click", async (event) => {
      const target = event.target as HTMLElement;
      const linha = target.closest<HTMLElement>("tr[data-lote-id]");
      if (!linha) return;
      const loteId = Number(linha.dataset.loteId);

      if (target.matches("[data-salvar-lote]")) {
        const quantidade = Number(linha.querySelector<HTMLInputElement>("[data-campo-quantidade]")?.value || 0);
        const valorCusto = Number(linha.querySelector<HTMLInputElement>("[data-campo-custo]")?.value || 0);
        const res = await fetch(`${directusUrl}/items/camiseta_lotes/${loteId}`, {
          method: "PATCH",
          headers: { Authorization: `Bearer ${token}`, "Content-Type": "application/json" },
          body: JSON.stringify({ quantidade, valor_custo: valorCusto }),
        });
        if (res.ok) {
          const item = lotesCompra.find((l) => l.id === loteId);
          if (item) { item.quantidade = quantidade; item.valor_custo = valorCusto; }
          atualizarStats();
        }
      }

      if (target.matches("[data-excluir-lote]")) {
        if (!confirm("Excluir esse lote de compra?")) return;
        const res = await fetch(`${directusUrl}/items/camiseta_lotes/${loteId}`, { method: "DELETE", headers: { Authorization: `Bearer ${token}` } });
        if (res.ok) {
          lotesCompra = lotesCompra.filter((l) => l.id !== loteId);
          renderizarLotesCompra();
          atualizarStats();
        }
      }
    });

    // --- pedidos: salvar valor pago / excluir / retirada por item ---
    listaEl?.addEventListener("click", async (event) => {
      const target = event.target as HTMLElement;
      const card = target.closest<HTMLElement>("[data-pedido-id]");
      if (!card) return;
      const pedidoId = Number(card.dataset.pedidoId);
      const pedido = pedidos.find((p) => p.id === pedidoId);
      if (!pedido) return;

      if (target.matches("[data-salvar-pedido]")) {
        const valorPago = Number(card.querySelector<HTMLInputElement>("[data-campo-valor-pago]")?.value || 0);
        target.textContent = "Salvando…";
        const res = await fetch(`${directusUrl}/items/camiseta_pedidos/${pedidoId}`, {
          method: "PATCH",
          headers: { Authorization: `Bearer ${token}`, "Content-Type": "application/json" },
          body: JSON.stringify({ valor_pago: valorPago }),
        });
        target.textContent = "Salvar";
        if (res.ok) {
          pedido.valor_pago = valorPago;
          atualizarStats();
          renderizarPedidos();
        }
      }

      if (target.matches("[data-excluir-pedido]")) {
        if (!confirm(`Excluir o pedido de "${pedido.nome}"? Isso apaga o pedido e todos os itens dele.`)) return;
        const res = await fetch(`${directusUrl}/items/camiseta_pedidos/${pedidoId}`, { method: "DELETE", headers: { Authorization: `Bearer ${token}` } });
        if (res.ok) {
          pedidos = pedidos.filter((p) => p.id !== pedidoId);
          atualizarStats();
          renderizarPedidos();
        }
      }

      const linhaItem = target.closest<HTMLElement>("[data-item-id]");
      if (linhaItem && target.matches("[data-salvar-item]")) {
        const itemId = Number(linhaItem.dataset.itemId);
        const novaRetirada = Number(linhaItem.querySelector<HTMLInputElement>("[data-campo-retirada]")?.value || 0);
        const res = await fetch(`${directusUrl}/items/camiseta_itens_pedido/${itemId}`, {
          method: "PATCH",
          headers: { Authorization: `Bearer ${token}`, "Content-Type": "application/json" },
          body: JSON.stringify({ quantidade_retirada: novaRetirada }),
        });
        if (res.ok) {
          const item = pedido.itens.find((i) => i.id === itemId);
          if (item) item.quantidade_retirada = novaRetirada;
          renderizarPedidos();
        }
      }
    });

    // --- venda avulsa ---
    const avulsoWrap = document.querySelector<HTMLElement>("[data-avulso-form-wrap]");
    document.querySelector("[data-abrir-avulso]")?.addEventListener("click", () => {
      if (avulsoWrap) avulsoWrap.hidden = !avulsoWrap.hidden;
    });

    function linhaItemAvulsoHtml() {
      const tamanhos = grupo.tamanhos ?? [];
      const modelos = grupo.modelos ?? [];
      const tamanhoOpcoes = tamanhos.length ? tamanhos.map((t) => `<option value="${t}">${t}</option>`).join("") : `<option value="">—</option>`;
      const modeloOpcoes = modelos.length ? modelos.map((m) => `<option value="${m}">${m}</option>`).join("") : `<option value="">—</option>`;
      return `
        <div class="grid gap-2 sm:grid-cols-[1fr_1fr_auto] item-linha">
          <select class="field" data-item-tamanho>${tamanhoOpcoes}</select>
          <select class="field" data-item-modelo>${modeloOpcoes}</select>
          <input type="number" min="1" value="1" class="field" style="width:5rem" data-item-quantidade />
        </div>
      `;
    }

    const avulsoItensEl = document.querySelector<HTMLElement>("[data-avulso-itens]");
    // A primeira linha só pode ser montada depois que `grupo` existir de
    // verdade (carregado dentro de `iniciar()`) — chamar isso aqui, no topo
    // do script, lia `grupo.tamanhos` com `grupo` ainda `undefined` e
    // quebrava a página inteira antes até de checar a sessão (bug real,
    // travava em "Verificando sua sessão…" pra sempre).
    document.querySelector("[data-avulso-item-adicionar]")?.addEventListener("click", () => {
      avulsoItensEl?.insertAdjacentHTML("beforeend", linhaItemAvulsoHtml());
    });

    document.querySelector("[data-avulso-salvar]")?.addEventListener("click", async () => {
      const statusEl = document.querySelector<HTMLElement>("[data-avulso-status]");
      const nome = (document.querySelector<HTMLInputElement>("[data-avulso-nome]")?.value ?? "").trim() || "Venda avulsa";
      const valorPago = Number(document.querySelector<HTMLInputElement>("[data-avulso-valor-pago]")?.value || 0);
      const itens = Array.from(document.querySelectorAll("[data-avulso-itens] .item-linha"))
        .map((linha) => ({
          tamanho: linha.querySelector<HTMLSelectElement>("[data-item-tamanho]")?.value || null,
          modelo: linha.querySelector<HTMLSelectElement>("[data-item-modelo]")?.value || null,
          quantidade: Number(linha.querySelector<HTMLInputElement>("[data-item-quantidade]")?.value || 0),
        }))
        .filter((i) => i.quantidade > 0);

      if (!itens.length) {
        if (statusEl) statusEl.textContent = "Adicione pelo menos um item.";
        return;
      }

      if (statusEl) statusEl.textContent = "Salvando…";
      try {
        const res = await fetch(`${directusUrl}/items/camiseta_pedidos`, {
          method: "POST",
          headers: { Authorization: `Bearer ${token}`, "Content-Type": "application/json" },
          body: JSON.stringify({ grupo: grupoId, nome, telefone: null, avulso: true, valor_pago: valorPago }),
        });
        if (!res.ok) throw new Error("falha ao criar pedido avulso");
        const novoPedido = (await res.json()).data;

        const itensSalvos: Item[] = [];
        for (const item of itens) {
          const itemRes = await fetch(`${directusUrl}/items/camiseta_itens_pedido`, {
            method: "POST",
            headers: { Authorization: `Bearer ${token}`, "Content-Type": "application/json" },
            body: JSON.stringify({ pedido: novoPedido.id, tamanho: item.tamanho, modelo: item.modelo, quantidade: item.quantidade }),
          });
          if (itemRes.ok) itensSalvos.push((await itemRes.json()).data);
        }

        pedidos.push({ ...novoPedido, congregacao: null, itens: itensSalvos });
        atualizarStats();
        renderizarPedidos();
        if (statusEl) statusEl.textContent = "✅ Venda avulsa registrada.";
        if (avulsoWrap) avulsoWrap.hidden = true;
      } catch {
        if (statusEl) statusEl.textContent = "Não foi possível salvar agora.";
      }
    });

    async function iniciar() {
      const tokenObtido = await exigirAutenticacao(directusUrl, AUTH);
      if (!tokenObtido) return;
      token = tokenObtido;

      if (!grupoId) {
        if (carregando) carregando.hidden = true;
        if (erroEl) erroEl.hidden = false;
        return;
      }

      const resGrupo = await fetch(`${directusUrl}/items/camiseta_grupos/${grupoId}?fields=id,nome,valor_venda,tamanhos,modelos`, {
        headers: { Authorization: `Bearer ${token}` },
      });
      if (!resGrupo.ok) {
        if (carregando) carregando.hidden = true;
        if (erroEl) erroEl.hidden = false;
        return;
      }
      grupo = (await resGrupo.json()).data;
      if (tituloEl) tituloEl.textContent = `Pedidos — ${grupo.nome}`;

      const resPedidos = await fetch(
        `${directusUrl}/items/camiseta_pedidos?filter[grupo][_eq]=${grupoId}&fields=id,nome,valor_pago,avulso,congregacao.name,itens.id,itens.tamanho,itens.modelo,itens.quantidade,itens.quantidade_retirada&sort=nome&limit=-1`,
        { headers: { Authorization: `Bearer ${token}` } },
      );
      pedidos = (await resPedidos.json()).data ?? [];
      pedidos.forEach((p) => { if (!p.itens) p.itens = []; });

      const resLotes = await fetch(`${directusUrl}/items/camiseta_lotes?filter[grupo][_eq]=${grupoId}&fields=id,tamanho,modelo,quantidade,valor_custo&limit=-1`, {
        headers: { Authorization: `Bearer ${token}` },
      });
      lotesCompra = (await resLotes.json()).data ?? [];

      const resPerguntas = await fetch(`${directusUrl}/items/perguntas_camiseta?filter[grupo][_eq]=${grupoId}&sort=ordem&limit=-1`, {
        headers: { Authorization: `Bearer ${token}` },
      });
      perguntas = (await resPerguntas.json()).data ?? [];

      if (perguntas.length && pedidos.length) {
        const idsPedidos = pedidos.map((p) => p.id).join(",");
        const resRespostas = await fetch(
          `${directusUrl}/items/respostas_pedido_camiseta?filter[pedido][_in]=${idsPedidos}&fields=pedido,pergunta,valor&limit=-1`,
          { headers: { Authorization: `Bearer ${token}` } },
        );
        const respostas: Resposta[] = (await resRespostas.json()).data ?? [];
        respostasPorPedido = new Map();
        for (const r of respostas) {
          const lista = respostasPorPedido.get(r.pedido) ?? [];
          lista.push(r);
          respostasPorPedido.set(r.pedido, lista);
        }
      }

      if (carregando) carregando.hidden = true;
      if (conteudoEl) conteudoEl.hidden = false;

      atualizarStats();
      renderizarLotesCompra();
      renderizarFiltroPergunta();
      renderizarPedidos();
      avulsoItensEl?.insertAdjacentHTML("beforeend", linhaItemAvulsoHtml());
    }

    iniciar();
  </script>

  <style is:global>
    .stat-card { border: 1px solid var(--border); border-radius: var(--radius-md); padding: 1rem 1.25rem; }
    .stat-numero { font-size: 1.5rem; font-weight: 700; }
    .stat-label { margin-top: 0.25rem; font-size: 0.8125rem; color: var(--muted-foreground); }
    .tamanho-chip { border: 1px solid var(--border); border-radius: 999px; padding: 0.25rem 0.75rem; font-size: 0.8125rem; }
    .filtro-chip { border: 1px solid var(--border); border-radius: 999px; padding: 0.35rem 0.9rem; font-size: 0.8125rem; background: transparent; cursor: pointer; }
    .filtro-chip.is-active { border-color: var(--accent); color: var(--accent); font-weight: 600; }
    .tabela-camiseta { width: 100%; border-collapse: collapse; font-size: 0.875rem; }
    .tabela-camiseta th, .tabela-camiseta td { padding: 0.5rem 0.75rem; border-bottom: 1px solid var(--border); text-align: left; }
    .camiseta-pedido-painel-card { border: 1px solid var(--border); border-radius: var(--radius-md); padding: 1rem 1.25rem; }
    .badge-avulso { margin-left: 0.5rem; font-size: 0.6875rem; font-weight: 600; border: 1px solid var(--accent); color: var(--accent); border-radius: 999px; padding: 0.1rem 0.5rem; }
  </style>
</BaseLayout>
