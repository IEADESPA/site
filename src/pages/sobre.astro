---
import { marked } from "marked";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig } from "@/config/site";
import { authorSlug, getAllAuthors, getAllMensagens, visiblePosts } from "@/lib/posts";
import { fetchConfiguracoes } from "@/lib/directus";

const allPosts = visiblePosts(await getAllMensagens());
const authors = getAllAuthors(allPosts);
const config = await fetchConfiguracoes();

/**
 * Quebra o texto único de `sobre_corpo` em seções fixas, usando os títulos
 * `##` que o próprio texto já usa ("Quem somos", "Nossa missão"...) — sem
 * precisar de campo novo no Directus nem mudar o conteúdo. Se um dia o
 * texto vier sem nenhum `##` (reescrito num bloco corrido), cai de volta
 * pra um bloco só, sem quebrar a página.
 */
function quebrarEmSecoes(markdown: string): { titulo: string; corpo: string }[] {
  const partes = markdown.split(/^##\s+(.+)$/m);
  if (partes.length < 3) return [{ titulo: "", corpo: markdown }];
  const secoes: { titulo: string; corpo: string }[] = [];
  for (let i = 1; i < partes.length; i += 2) {
    secoes.push({ titulo: partes[i].trim(), corpo: partes[i + 1]?.trim() ?? "" });
  }
  return secoes;
}

const secoesSobre = await Promise.all(
  quebrarEmSecoes(config.sobre_corpo).map(async (secao) => ({
    ...secao,
    html: await marked.parse(secao.corpo),
  })),
);
---

<BaseLayout
  title="Sobre"
  description={`Sobre a ${siteConfig.fullName} — nossa história, missão e liderança.`}
>
  <SiteHeader posts={allPosts} />
  <main id="content" class="outer">
    <div class="canvas">
      <header class="pagehead">
        <p class="eyebrow">Sobre nós</p>
        <h1 class="pagehead-title">{siteConfig.name}</h1>
        <p class="pagehead-description">{config.about}</p>
      </header>

      <div class="grid gap-8 mt-2">
        {
          secoesSobre.map((secao) =>
            secao.titulo ? (
              <section class="sobre-secao" aria-labelledby={`sobre-${secao.titulo}`}>
                <h2 id={`sobre-${secao.titulo}`} class="section-title">{secao.titulo}</h2>
                <div class="prose mt-3" set:html={secao.html} />
              </section>
            ) : (
              <div class="prose" set:html={secao.html} />
            ),
          )
        }
      </div>

      <p class="mt-8">
        <a href="/historia/" class="link-sweep font-semibold text-accent">Conheça nossa história completa &rarr;</a>
      </p>

      <div class="prose mt-16">
        <h2>Liderança</h2>
        <p>
          Aqui embaixo estão só quem já pregou mensagens publicadas no site. Pra conhecer a
          governança, os departamentos e as secretarias da igreja, veja a página de{" "}
          <a href="/orgaos/">Órgãos</a>.
        </p>
        <ul>
          {
            authors.map((author) => (
              <li>
                <a href={`/pregador/${authorSlug(author.name)}/`}>{author.name}</a> — {author.role} ({author.posts.length} {author.posts.length === 1 ? "mensagem" : "mensagens"})
              </li>
            ))
          }
        </ul>

        <h2>Próximos passos</h2>
        <p>
          Primeira vez na igreja? Veja a página do <a href="/visitante/">visitante</a> pra saber o
          que esperar do culto e como chegar. Pra conhecer a prestação de contas da igreja, veja a
          página de <a href="/transparencia/">transparência</a>.
        </p>

        <h2>Fale conosco</h2>
        <p>
          Dúvidas, pedidos de oração e visitas são bem-vindos através da <a href="/contato/">página de contato</a>.
        </p>
        {
          siteConfig.email && (
            <p>Você também pode escrever diretamente para <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>.</p>
          )
        }
      </div>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .sobre-secao {
    border-left: 3px solid var(--accent);
    padding-left: 1.25rem;
  }
</style>
