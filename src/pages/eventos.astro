---
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig } from "@/config/site";
import { getAllMensagens, visiblePosts } from "@/lib/posts";
import { fetchItems } from "@/lib/directus";

interface Evento {
  slug: string;
  title: string;
  event_date: string | null;
  time: string | null;
  location: string | null;
  description: string;
  body: string | null;
  registration_url: string | null;
}

interface Programacao {
  day: "terca" | "quarta" | "quinta" | "sexta" | "sabado" | "domingo_manha" | "domingo_noite";
  title: string;
  scope: "sede" | "congregacoes" | "todas";
  occurrence: "1" | "2" | "3" | "4_se_5" | "ultimo" | null;
  time: string | null;
}

const DAY_ORDER: Programacao["day"][] = [
  "terca",
  "quarta",
  "quinta",
  "sexta",
  "sabado",
  "domingo_manha",
  "domingo_noite",
];
const DAY_LABEL: Record<Programacao["day"], string> = {
  terca: "Terça-feira",
  quarta: "Quarta-feira",
  quinta: "Quinta-feira",
  sexta: "Sexta-feira",
  sabado: "Sábado",
  domingo_manha: "Domingo de manhã",
  domingo_noite: "Domingo à noite",
};
const SCOPE_LABEL: Record<Programacao["scope"], string> = {
  sede: "Somente na Sede",
  congregacoes: "Nas congregações",
  todas: "Sede e congregações",
};
const OCCURRENCE_LABEL: Record<NonNullable<Programacao["occurrence"]>, string> = {
  "1": "1º domingo",
  "2": "2º domingo",
  "3": "3º domingo",
  "4_se_5": "4º domingo (meses com 5 domingos)",
  ultimo: "Último domingo do mês",
};

const allPosts = visiblePosts(await getAllMensagens());
const events = (await fetchItems<Evento>("eventos")).sort((a, b) => {
  const dateA = a.event_date ? new Date(a.event_date).getTime() : Number.POSITIVE_INFINITY;
  const dateB = b.event_date ? new Date(b.event_date).getTime() : Number.POSITIVE_INFINITY;
  return dateA - dateB;
});
const dateFormatter = new Intl.DateTimeFormat(siteConfig.dateLocale, { day: "numeric", month: "long", year: "numeric" });

const programacao = await fetchItems<Programacao>("programacao", "sort[]=sort");
const schedule = DAY_ORDER.map((day) => ({
  day,
  label: DAY_LABEL[day],
  items: programacao.filter((item) => item.day === day),
})).filter((group) => group.items.length > 0);
---

<BaseLayout title="Eventos" description={`Seminários, campanhas e eventos especiais da ${siteConfig.name}.`}>
  <SiteHeader posts={allPosts} />
  <main id="content" class="outer">
    <div class="canvas">
      <header class="pagehead">
        <p class="eyebrow">Agenda</p>
        <h1 class="pagehead-title">Eventos e programação</h1>
        <p class="pagehead-description">
          A programação semanal de cultos e os eventos especiais da igreja.
        </p>
      </header>

      {
        schedule.length > 0 && (
          <section aria-labelledby="schedule-heading">
            <h2 id="schedule-heading" class="section-title">Programação semanal</h2>
            <ul class="mt-5 grid gap-4">
              {schedule.map((group) => (
                <li class="schedule-card">
                  <span class="schedule-day">{group.label}</span>
                  <ul class="mt-2 grid gap-2">
                    {group.items.map((item) => (
                      <li class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                        <span>
                          {item.occurrence && (
                            <span class="schedule-occurrence">{OCCURRENCE_LABEL[item.occurrence]}: </span>
                          )}
                          {item.title}
                        </span>
                        <span class="text-sm text-muted-foreground">
                          {SCOPE_LABEL[item.scope]}
                          {item.time && ` · ${item.time}`}
                        </span>
                      </li>
                    ))}
                  </ul>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <section class="mt-16" aria-labelledby="special-events-heading">
        <h2 id="special-events-heading" class="section-title">Eventos especiais</h2>

      {
        events.length > 0 ? (
          <ul class="grid gap-5">
            {events.map((event) => (
              <li class="event-card">
                <div class="flex flex-wrap items-baseline justify-between gap-3">
                  <h3 class="text-lg font-semibold tracking-tight">{event.title}</h3>
                  {event.event_date && (
                    <span class="pill shrink-0">
                      {dateFormatter.format(new Date(event.event_date))}
                      {event.time && ` · ${event.time}`}
                    </span>
                  )}
                </div>
                {event.location && <p class="mt-1 text-sm text-muted-foreground">{event.location}</p>}
                <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{event.description}</p>
                <div class="mt-3 flex flex-wrap gap-4">
                  {event.body && (
                    <a href={`/evento/${event.slug}/`} class="link-sweep text-sm font-semibold text-accent">Ver detalhes</a>
                  )}
                  {event.registration_url && (
                    <a href={event.registration_url} target="_blank" rel="noreferrer" class="link-sweep text-sm font-semibold text-accent">Inscreva-se</a>
                  )}
                </div>
              </li>
            ))}
          </ul>
        ) : (
          <div class="gallery-empty">
            <p class="text-sm leading-relaxed text-muted-foreground">Nenhum evento especial cadastrado no momento.</p>
          </div>
        )
      }
      </section>

      <div class="prose mt-16">
        <h2>Fique por dentro</h2>
        <p>
          Siga nosso Instagram <a href="https://instagram.com/adsetaparauapebas" target="_blank" rel="noreferrer">@adsetaparauapebas</a>{" "}
          para avisos de eventos especiais, ou acompanhe as <a href="/noticias/">notícias da igreja</a>.
        </p>
      </div>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .schedule-card {
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 1.25rem 1.4rem;
  }

  .schedule-day {
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .schedule-occurrence {
    color: var(--accent);
    font-weight: 600;
  }

  .event-card {
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 1.5rem 1.6rem;
  }

  .gallery-empty {
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius-md);
    padding: 2.5rem 1.5rem;
    text-align: center;
  }
</style>
