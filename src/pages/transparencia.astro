---
import { getCollection } from "astro:content";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig } from "@/config/site";
import { visiblePosts } from "@/lib/posts";

const allPosts = visiblePosts(await getCollection("posts"));

/** Substitua pelos nomes reais da diretoria em exercício. */
const board = [
  { role: "Pastor Presidente", name: "A definir" },
  { role: "Vice-presidente", name: "A definir" },
  { role: "Secretário(a)", name: "A definir" },
  { role: "Tesoureiro(a)", name: "A definir" },
];

/** Publicados pela diretoria através do painel administrativo em /admin. */
const reports = (await getCollection("relatorios")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<BaseLayout
  title="Transparência"
  description={`Diretoria e prestação de contas da ${siteConfig.name}.`}
>
  <SiteHeader posts={allPosts} />
  <main id="content" class="outer">
    <div class="canvas">
      <header class="pagehead">
        <p class="eyebrow">Prestação de contas</p>
        <h1 class="pagehead-title">Transparência</h1>
        <p class="pagehead-description">
          Informações sobre a diretoria da igreja e os relatórios de prestação de contas à
          congregação.
        </p>
      </header>

      <section aria-labelledby="board-heading">
        <h2 id="board-heading" class="section-title">Diretoria</h2>
        <ul class="grid gap-4 sm:grid-cols-2">
          {
            board.map((member) => (
              <li class="board-card">
                <span class="block text-xs font-semibold tracking-wide text-accent uppercase">{member.role}</span>
                <span class="mt-1 block text-lg font-semibold tracking-tight">{member.name}</span>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="mt-16" aria-labelledby="reports-heading">
        <h2 id="reports-heading" class="section-title">Relatórios</h2>
        {
          reports.length > 0 ? (
            <ul class="grid gap-4">
              {reports.map((report) => (
                <li class="report-card">
                  <a href={report.data.file} target="_blank" rel="noreferrer" class="link-title flex items-baseline justify-between gap-4">
                    <span>
                      <span class="link-title__text block text-base font-semibold tracking-tight">{report.data.title}</span>
                      {report.data.excerpt && (
                        <span class="mt-1 block text-sm text-muted-foreground">{report.data.excerpt}</span>
                      )}
                    </span>
                    <span class="pill shrink-0">{report.data.period}</span>
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <div class="gallery-empty">
              <p class="text-sm leading-relaxed text-muted-foreground">
                Nenhum relatório publicado ainda. Assim que a diretoria publicar um relatório de
                prestação de contas pelo <a href="/admin/">painel administrativo</a>, ele aparecerá
                aqui.
              </p>
            </div>
          )
        }
      </section>

      <div class="prose mt-16">
        <h2>Dúvidas sobre os relatórios</h2>
        <p>
          Membros da igreja podem solicitar mais detalhes sobre a prestação de contas pela{" "}
          <a href="/contato/">página de contato</a>.
        </p>
      </div>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .board-card,
  .report-card {
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 1.25rem 1.4rem;
  }

  .gallery-empty {
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius-md);
    padding: 2.5rem 1.5rem;
    text-align: center;
  }
</style>
