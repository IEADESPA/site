---
import type { GetStaticPaths, Page } from "astro";
import PostCard from "@/components/PostCard.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig } from "@/config/site";
import { getAllMensagens, visiblePosts, type Post } from "@/lib/posts";

export const getStaticPaths = (async ({ paginate }) => {
  const posts = visiblePosts(await getAllMensagens());
  return paginate(posts, { pageSize: 10 });
}) satisfies GetStaticPaths;

interface Props {
  page: Page<Post>;
}

const { page } = Astro.props;
const allPosts = visiblePosts(await getAllMensagens());
const title = page.currentPage === 1 ? "Mensagens" : `Mensagens - Página ${page.currentPage}`;
const description = `Todas as mensagens publicadas por ${siteConfig.name}.`;
const withTrailingSlash = (url: string | undefined) => (url && !url.endsWith("/") ? `${url}/` : url);
const prevUrl = withTrailingSlash(page.url.prev);
const nextUrl = withTrailingSlash(page.url.next);
---

<BaseLayout title={title} description={description} prevUrl={prevUrl} nextUrl={nextUrl}>
  <SiteHeader posts={allPosts} />
  <main id="content" class="outer">
    <div class="canvas">
      <header class="pagehead">
        <p class="eyebrow">Arquivo</p>
        <h1 class="pagehead-title">Mensagens</h1>
        <p class="pagehead-description">
          {page.total} {page.total === 1 ? "mensagem" : "mensagens"}, mais recentes primeiro. Página {page.currentPage} de {page.lastPage}.
        </p>
      </header>

      <div class="feed">
        {page.data.map((post) => <PostCard post={post} />)}
      </div>

      <nav class="mt-16 flex items-center justify-between gap-4 border-t border-border pt-6" aria-label="Paginação do arquivo">
        {
          prevUrl ? (
            <a href={prevUrl} class="nav-link link-nudge">
              <span class="link-nudge__arrow link-nudge__arrow--prev">&larr;</span> Mais recentes
            </a>
          ) : (
            <span class="nav-link text-muted-foreground">&larr; Mais recentes</span>
          )
        }
        <span class="text-xs tracking-widest text-muted-foreground uppercase">
          Página {page.currentPage} / {page.lastPage}
        </span>
        {
          nextUrl ? (
            <a href={nextUrl} class="nav-link link-nudge">
              Mais antigas <span class="link-nudge__arrow link-nudge__arrow--next">&rarr;</span>
            </a>
          ) : (
            <span class="nav-link text-muted-foreground">Mais antigas &rarr;</span>
          )
        }
      </nav>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>
