---
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { DIRECTUS_URL, fetchItems } from "@/lib/directus";
import { getAllMensagens, visiblePosts } from "@/lib/posts";

const allPosts = visiblePosts(await getAllMensagens());
const congregacoes = (await fetchItems<{ id: number; name: string }>("congregacoes", "fields=id,name&sort=name")).sort((a, b) =>
  a.name.localeCompare(b.name, "pt-BR"),
);

const tipoResponsavelOpcoes = [
  { value: "", label: "Sem categoria" },
  { value: "diretoria", label: "Diretoria" },
  { value: "conselho", label: "Conselho" },
  { value: "congregacao", label: "Congregação" },
  { value: "departamento", label: "Departamento/Ministério" },
  { value: "area", label: "Área/Regional" },
];

const tipoPerguntaOpcoes = [
  { value: "texto_curto", label: "Texto curto" },
  { value: "texto_longo", label: "Texto longo" },
  { value: "numero", label: "Número" },
  { value: "data", label: "Data" },
  { value: "selecao_unica", label: "Seleção única" },
  { value: "selecao_multipla", label: "Seleção múltipla" },
];
---

<BaseLayout title="Editar evento — Gestão de eventos" description="Área restrita da equipe." noindex>
  <SiteHeader posts={allPosts} />
  <main id="content" class="outer">
    <div class="canvas evento-canvas" data-directus-url={DIRECTUS_URL}>
      <header class="pagehead">
        <p class="eyebrow"><a href="/painel-eventos/" class="text-accent">← Gestão de eventos</a></p>
        <div class="flex flex-wrap items-baseline justify-between gap-3">
          <h1 class="pagehead-title" data-painel-titulo>Evento</h1>
          <a href="/painel-eventos/evento/inscritos/" class="btn btn-outline" data-link-inscritos hidden>
            Ver inscritos
          </a>
        </div>
        <p class="pagehead-description" data-painel-carregando>Verificando sua sessão…</p>
      </header>

      <div hidden data-painel-erro class="gallery-empty mt-8">
        <p class="text-sm text-muted-foreground">Evento não encontrado.</p>
      </div>

      <form hidden class="mt-8 grid gap-5 max-w-2xl" data-evento-form>
        <div class="grid gap-2">
          <label class="text-sm font-semibold" for="f-title">Título</label>
          <input id="f-title" class="field" required />
        </div>

        <div class="grid gap-2 sm:grid-cols-[1fr_auto] sm:items-end">
          <div class="grid gap-2">
            <label class="text-sm font-semibold" for="f-slug">Endereço (slug)</label>
            <input id="f-slug" class="field" placeholder="nome-do-evento" />
          </div>
          <button type="button" class="btn btn-outline" data-gerar-slug>Gerar do título</button>
        </div>

        <div class="grid gap-2">
          <label class="text-sm font-semibold" for="f-description">Resumo curto</label>
          <input id="f-description" class="field" placeholder="Aparece na listagem e no compartilhamento" />
        </div>

        <div class="grid gap-2">
          <label class="text-sm font-semibold" for="f-body">Descrição completa (markdown)</label>
          <textarea id="f-body" rows="6" class="field"></textarea>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          <div class="grid gap-2">
            <label class="text-sm font-semibold" for="f-event-date">Data</label>
            <input id="f-event-date" type="date" class="field" />
          </div>
          <div class="grid gap-2">
            <label class="text-sm font-semibold" for="f-end-date">Data final (se for vários dias)</label>
            <input id="f-end-date" type="date" class="field" />
          </div>
          <div class="grid gap-2">
            <label class="text-sm font-semibold" for="f-time">Horário</label>
            <input id="f-time" class="field" placeholder="19h30" />
          </div>
          <div class="grid gap-2">
            <label class="text-sm font-semibold" for="f-end-time">Horário final</label>
            <input id="f-end-time" class="field" placeholder="22h" />
          </div>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          <div class="grid gap-2">
            <label class="text-sm font-semibold" for="f-congregacao">Congregação (se aplicável)</label>
            <select id="f-congregacao" class="field">
              <option value="">— Nenhuma (usar local abaixo) —</option>
              {congregacoes.map((c) => <option value={c.id}>{c.name}</option>)}
            </select>
          </div>
          <div class="grid gap-2">
            <label class="text-sm font-semibold" for="f-location">Local (se não for numa congregação)</label>
            <input id="f-location" class="field" />
          </div>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          <div class="grid gap-2">
            <label class="text-sm font-semibold" for="f-responsavel">Responsável (nome/ministério)</label>
            <input id="f-responsavel" class="field" />
          </div>
          <div class="grid gap-2">
            <label class="text-sm font-semibold" for="f-tipo-responsavel">Categoria do responsável</label>
            <select id="f-tipo-responsavel" class="field">
              {tipoResponsavelOpcoes.map((o) => <option value={o.value}>{o.label}</option>)}
            </select>
          </div>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          <div class="grid gap-2">
            <label class="text-sm font-semibold" for="f-vagas">Limite de vagas (opcional)</label>
            <input id="f-vagas" type="number" min="0" class="field" placeholder="Deixe em branco = ilimitado" />
          </div>
          <div class="grid gap-2">
            <label class="text-sm font-semibold" for="f-inscricoes-ate">Inscrições até</label>
            <input id="f-inscricoes-ate" type="date" class="field" />
          </div>
        </div>
        <p class="text-xs text-muted-foreground">
          Com limite preenchido, o formulário público trava de verdade — quem se inscrever depois
          das vagas esgotarem entra na lista de espera automaticamente. Se você aumentar o limite
          (ou apagá-lo, deixando ilimitado) e salvar, quem estiver na lista de espera é confirmado
          sozinho, do mais antigo pro mais novo, até preencher as vagas novas.
        </p>

        <fieldset class="grid gap-2">
          <legend class="text-sm font-semibold">Faixas de valor (opcional)</legend>
          <p class="text-xs text-muted-foreground">
            Só informativo, aparece na página pública do evento — não processa pagamento nenhum.
            Ex.: "Individual" R$50, "Casal" R$80, "Grupo (3 ou mais, por pessoa)" R$40.
          </p>
          <div class="grid gap-2" data-faixas-lista></div>
          <button type="button" class="btn btn-outline mt-1" data-faixa-adicionar>+ Adicionar faixa</button>
        </fieldset>

        <div class="grid gap-3">
          <label class="flex items-center gap-2 text-sm">
            <input id="f-inscricoes-encerradas" type="checkbox" /> Encerrar inscrições manualmente agora
          </label>
        </div>

        <div class="flex items-center gap-4">
          <button type="submit" class="btn btn-solid" data-evento-salvar>Salvar evento</button>
          <p class="text-sm" data-evento-status role="status" aria-live="polite"></p>
        </div>
      </form>

      <div hidden class="mt-10 zona-encerrar" data-zona-encerrar>
        <p class="text-sm font-semibold">Encerrar evento</p>
        <p class="mt-1 text-sm text-muted-foreground">
          Baixa um relatório de encerramento em PDF (resumo + fechamento de caixa) e cria um
          rascunho de notícia (não publicado, pra revisar antes) — depois remove só o telefone de
          cada inscrito. Nome, código, presença, respostas e valores <strong>continuam guardados
          pra sempre</strong> — é o que garante que a pessoa consiga baixar o certificado dela a
          qualquer momento, mesmo anos depois. Não é uma exclusão.
        </p>
        <button type="button" class="btn btn-outline mt-3" data-encerrar-evento>Encerrar evento</button>
        <p class="mt-2 text-sm" data-encerrar-status role="status" aria-live="polite"></p>
      </div>

      <div hidden class="mt-6 zona-perigo" data-zona-perigo>
        <p class="text-sm font-semibold text-red-700">Excluir evento</p>
        <p class="mt-1 text-sm text-muted-foreground">
          Remove o evento, suas perguntas e todas as inscrições (com respostas). Não pode ser
          desfeito.
        </p>
        <button type="button" class="btn btn-outline btn-excluir-evento mt-3" data-excluir-evento>Excluir evento</button>
        <p class="mt-2 text-sm" data-excluir-status role="status" aria-live="polite"></p>
      </div>

      <section hidden class="mt-16" data-perguntas-secao aria-labelledby="perguntas-heading">
        <h2 id="perguntas-heading" class="section-title">Perguntas do formulário de inscrição</h2>
        <p class="mt-2 text-sm text-muted-foreground">
          Cada evento define suas próprias perguntas — não existe campo fixo além de nome e
          telefone. Ex.: "Qual sua congregação?", "Vai levar acompanhante?", "Contribuição (R$)".
        </p>

        <div class="mt-5 grid gap-3" data-perguntas-lista></div>

        <div class="mt-6 pergunta-card" data-pergunta-nova>
          <p class="text-sm font-semibold">+ Nova pergunta</p>
          <div class="mt-3 grid gap-3 sm:grid-cols-2">
            <input type="text" class="field" placeholder="Texto da pergunta" data-novo-label />
            <select class="field" data-novo-tipo>
              {tipoPerguntaOpcoes.map((o) => <option value={o.value}>{o.label}</option>)}
            </select>
          </div>
          <textarea class="field mt-3" rows="2" placeholder="Opções (uma por linha) — só pra seleção única/múltipla" data-novo-opcoes hidden></textarea>
          <div class="mt-3 grid gap-1">
            <label class="text-xs font-semibold text-muted-foreground">Quando perguntar</label>
            <select class="field" data-novo-momento>
              <option value="inscricao">Na inscrição</option>
              <option value="pos_evento">Depois do evento (pesquisa de satisfação)</option>
            </select>
          </div>
          <div class="mt-3 flex items-center justify-between gap-3">
            <label class="flex items-center gap-2 text-sm">
              <input type="checkbox" data-novo-obrigatoria /> Obrigatória
            </label>
            <button type="button" class="btn btn-outline" data-adicionar-pergunta>Adicionar pergunta</button>
          </div>
        </div>
        <p class="mt-3 text-xs text-muted-foreground">
          Perguntas "depois do evento" viram a pesquisa de satisfação pública (em <code>/pesquisa/&lt;slug do evento&gt;/</code>), liberada
          automaticamente a partir do dia seguinte ao evento — nunca aparecem no formulário de inscrição.
        </p>
      </section>
    </div>
  </main>
  <SiteFooter />

  <script>
    import { jsPDF } from "jspdf";
    import { contarRespostas, desenharGraficoBarrasPDF } from "@/lib/graficos";
    import { exigirAutenticacao } from "@/lib/painelAuth";

    interface Evento {
      id: number;
      title: string;
      slug: string | null;
      description: string | null;
      body: string | null;
      event_date: string | null;
      end_date: string | null;
      time: string | null;
      end_time: string | null;
      congregacao: number | null;
      location: string | null;
      responsavel: string | null;
      tipo_responsavel: string | null;
      vagas_limite: number | null;
      inscricoes_ate: string | null;
      inscricoes_encerradas: boolean;
      faixas_valor: { descricao: string; valor: number }[] | null;
    }

    interface Pergunta {
      id: number;
      ordem: number | null;
      label: string;
      tipo: string;
      opcoes: string[] | null;
      obrigatoria: boolean;
      momento: string;
    }

    const container = document.querySelector<HTMLElement>("[data-directus-url]");
    if (!container) throw new Error("contêiner do painel ausente");
    const directusUrl = container.dataset.directusUrl ?? "";

    const idParam = new URLSearchParams(window.location.search).get("id");
    const eventoId = idParam ? Number(idParam) : null;

    const carregando = document.querySelector<HTMLElement>("[data-painel-carregando]");
    const erroEl = document.querySelector<HTMLElement>("[data-painel-erro]");
    const tituloEl = document.querySelector<HTMLElement>("[data-painel-titulo]");
    const form = document.querySelector<HTMLFormElement>("[data-evento-form]");
    const statusEl = document.querySelector<HTMLElement>("[data-evento-status]");
    const perguntasSecao = document.querySelector<HTMLElement>("[data-perguntas-secao]");
    const perguntasLista = document.querySelector<HTMLElement>("[data-perguntas-lista]");

    const el = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
    const fTitle = el<HTMLInputElement>("f-title");
    const fSlug = el<HTMLInputElement>("f-slug");
    const fDescription = el<HTMLInputElement>("f-description");
    const fBody = el<HTMLTextAreaElement>("f-body");
    const fEventDate = el<HTMLInputElement>("f-event-date");
    const fEndDate = el<HTMLInputElement>("f-end-date");
    const fTime = el<HTMLInputElement>("f-time");
    const fEndTime = el<HTMLInputElement>("f-end-time");
    const fCongregacao = el<HTMLSelectElement>("f-congregacao");
    const fLocation = el<HTMLInputElement>("f-location");
    const fResponsavel = el<HTMLInputElement>("f-responsavel");
    const fTipoResponsavel = el<HTMLSelectElement>("f-tipo-responsavel");
    const fVagas = el<HTMLInputElement>("f-vagas");
    const fInscricoesAte = el<HTMLInputElement>("f-inscricoes-ate");
    const fInscricoesEncerradas = el<HTMLInputElement>("f-inscricoes-encerradas");

    function slugify(texto: string): string {
      return texto
        .normalize("NFD")
        .replace(/\p{Diacritic}/gu, "")
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, "-")
        .replace(/^-+|-+$/g, "");
    }

    document.querySelector("[data-gerar-slug]")?.addEventListener("click", () => {
      fSlug.value = slugify(fTitle.value);
    });

    function preencherFormulario(evento: Evento) {
      fTitle.value = evento.title ?? "";
      fSlug.value = evento.slug ?? "";
      fDescription.value = evento.description ?? "";
      fBody.value = evento.body ?? "";
      fEventDate.value = evento.event_date ?? "";
      fEndDate.value = evento.end_date ?? "";
      fTime.value = evento.time ?? "";
      fEndTime.value = evento.end_time ?? "";
      fCongregacao.value = evento.congregacao ? String(evento.congregacao) : "";
      fLocation.value = evento.location ?? "";
      fResponsavel.value = evento.responsavel ?? "";
      fTipoResponsavel.value = evento.tipo_responsavel ?? "";
      fVagas.value = evento.vagas_limite ? String(evento.vagas_limite) : "";
      fInscricoesAte.value = evento.inscricoes_ate ?? "";
      fInscricoesEncerradas.checked = Boolean(evento.inscricoes_encerradas);
      renderizarFaixas(evento.faixas_valor ?? []);
    }

    function lerFormulario() {
      return {
        title: fTitle.value.trim(),
        slug: fSlug.value.trim() || slugify(fTitle.value),
        description: fDescription.value.trim() || null,
        body: fBody.value || null,
        event_date: fEventDate.value || null,
        end_date: fEndDate.value || null,
        time: fTime.value.trim() || null,
        end_time: fEndTime.value.trim() || null,
        congregacao: fCongregacao.value ? Number(fCongregacao.value) : null,
        location: fLocation.value.trim() || null,
        responsavel: fResponsavel.value.trim() || null,
        tipo_responsavel: fTipoResponsavel.value || null,
        vagas_limite: fVagas.value ? Number(fVagas.value) : null,
        inscricoes_ate: fInscricoesAte.value || null,
        inscricoes_encerradas: fInscricoesEncerradas.checked,
        faixas_valor: lerFaixas(),
        aceita_inscricao: true,
      };
    }

    const faixasListaEl = document.querySelector<HTMLElement>("[data-faixas-lista]");

    function linhaFaixaHtml(descricao: string, valor: string) {
      return `
        <div class="grid gap-2 sm:grid-cols-[1fr_auto_auto] sm:items-center faixa-linha">
          <input type="text" class="field" placeholder="Ex.: Casal" value="${descricao.replace(/"/g, "&quot;")}" data-faixa-descricao />
          <input type="number" step="0.01" class="field faixa-valor" placeholder="R$" value="${valor}" data-faixa-valor />
          <button type="button" class="btn btn-outline" data-faixa-remover>Remover</button>
        </div>
      `;
    }

    function renderizarFaixas(faixas: { descricao: string; valor: number }[]) {
      if (!faixasListaEl) return;
      faixasListaEl.innerHTML = faixas.map((f) => linhaFaixaHtml(f.descricao, String(f.valor ?? ""))).join("");
    }

    function lerFaixas(): { descricao: string; valor: number }[] {
      if (!faixasListaEl) return [];
      return Array.from(faixasListaEl.querySelectorAll<HTMLElement>(".faixa-linha"))
        .map((linha) => {
          const descricao = linha.querySelector<HTMLInputElement>("[data-faixa-descricao]")?.value.trim() ?? "";
          const valor = Number(linha.querySelector<HTMLInputElement>("[data-faixa-valor]")?.value ?? 0);
          return { descricao, valor };
        })
        .filter((f) => f.descricao);
    }

    document.querySelector("[data-faixa-adicionar]")?.addEventListener("click", () => {
      if (!faixasListaEl) return;
      faixasListaEl.insertAdjacentHTML("beforeend", linhaFaixaHtml("", ""));
    });

    faixasListaEl?.addEventListener("click", (event) => {
      const target = event.target as HTMLElement;
      if (target.matches("[data-faixa-remover]")) target.closest(".faixa-linha")?.remove();
    });

    const rotuloTipoPergunta: Record<string, string> = {
      texto_curto: "Texto curto",
      texto_longo: "Texto longo",
      numero: "Número",
      data: "Data",
      selecao_unica: "Seleção única",
      selecao_multipla: "Seleção múltipla",
    };

    function escapeHtml(value: string) {
      return String(value).replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c] ?? c);
    }

    async function carregarPerguntas(token: string, id: number) {
      if (!perguntasLista) return;
      const res = await fetch(`${directusUrl}/items/perguntas_evento?filter[evento][_eq]=${id}&sort=ordem&limit=-1`, {
        headers: { Authorization: `Bearer ${token}` },
      });
      const json = await res.json();
      const perguntas: Pergunta[] = json.data ?? [];

      perguntasLista.innerHTML = perguntas
        .map(
          (p) => `
            <div class="pergunta-card" data-pergunta-id="${p.id}">
              <div class="grid gap-3 sm:grid-cols-[1fr_auto_auto] sm:items-center">
                <input type="text" class="field" value="${escapeHtml(p.label)}" data-campo="label" />
                <select class="field" data-campo="tipo">
                  ${Object.entries(rotuloTipoPergunta)
                    .map(([value, label]) => `<option value="${value}" ${value === p.tipo ? "selected" : ""}>${label}</option>`)
                    .join("")}
                </select>
                <input type="number" class="field ordem-input" value="${p.ordem ?? 0}" data-campo="ordem" title="Ordem" />
              </div>
              <textarea class="field mt-3" rows="2" placeholder="Opções (uma por linha)" data-campo="opcoes" ${
                p.tipo === "selecao_unica" || p.tipo === "selecao_multipla" ? "" : "hidden"
              }>${(p.opcoes ?? []).join("\n")}</textarea>
              <div class="mt-3 grid gap-1">
                <label class="text-xs font-semibold text-muted-foreground">Quando perguntar</label>
                <select class="field" data-campo="momento">
                  <option value="inscricao" ${p.momento !== "pos_evento" ? "selected" : ""}>Na inscrição</option>
                  <option value="pos_evento" ${p.momento === "pos_evento" ? "selected" : ""}>Depois do evento (pesquisa)</option>
                </select>
              </div>
              <div class="mt-3 flex items-center justify-between gap-3">
                <label class="flex items-center gap-2 text-sm">
                  <input type="checkbox" data-campo="obrigatoria" ${p.obrigatoria ? "checked" : ""} /> Obrigatória
                </label>
                <div class="flex gap-3">
                  <button type="button" class="btn btn-outline" data-salvar-pergunta>Salvar</button>
                  <button type="button" class="btn btn-outline" data-excluir-pergunta>Excluir</button>
                </div>
              </div>
            </div>
          `,
        )
        .join("");
    }

    async function iniciar() {
      const token = await exigirAutenticacao(directusUrl);
      if (!token) return;

      if (!eventoId) {
        if (carregando) carregando.hidden = true;
        if (erroEl) erroEl.hidden = false;
        return;
      }

      const res = await fetch(`${directusUrl}/items/eventos/${eventoId}`, { headers: { Authorization: `Bearer ${token}` } });
      if (!res.ok) {
        if (carregando) carregando.hidden = true;
        if (erroEl) erroEl.hidden = false;
        return;
      }
      const json = await res.json();
      const evento: Evento = json.data;

      if (tituloEl) tituloEl.textContent = evento.title;
      preencherFormulario(evento);

      const linkInscritos = document.querySelector<HTMLAnchorElement>("[data-link-inscritos]");
      if (linkInscritos) {
        linkInscritos.href = `/painel-eventos/evento/inscritos/?id=${eventoId}`;
        linkInscritos.hidden = false;
      }

      if (carregando) carregando.hidden = true;
      if (form) form.hidden = false;
      if (perguntasSecao) perguntasSecao.hidden = false;

      const zonaPerigo = document.querySelector<HTMLElement>("[data-zona-perigo]");
      if (zonaPerigo) zonaPerigo.hidden = false;
      const zonaEncerrar = document.querySelector<HTMLElement>("[data-zona-encerrar]");
      if (zonaEncerrar) zonaEncerrar.hidden = false;

      await carregarPerguntas(token, eventoId);

      document.querySelector("[data-encerrar-evento]")?.addEventListener("click", async () => {
        const encerrarStatus = document.querySelector<HTMLElement>("[data-encerrar-status]");
        if (
          !confirm(
            `Encerrar "${evento.title}"? Isso baixa o relatório de encerramento, cria um rascunho de notícia, e apaga o telefone de cada inscrito (nome, código, presença e respostas continuam guardados).`,
          )
        )
          return;
        if (encerrarStatus) encerrarStatus.textContent = "Gerando relatório…";

        try {
          const resInscritos = await fetch(
            `${directusUrl}/items/inscricoes_eventos?filter[evento][_eq]=${eventoId}&fields=id,nome,pago,valor,presente&limit=-1`,
            { headers: { Authorization: `Bearer ${token}` } },
          );
          const inscritos: { id: number; nome: string; pago: boolean; valor: number | null; presente: boolean }[] =
            (await resInscritos.json()).data ?? [];

          const totalInscritos = inscritos.length;
          const presentes = inscritos.filter((i) => i.presente).length;
          const pagos = inscritos.filter((i) => i.pago);
          const naoPagos = totalInscritos - pagos.length;
          const valorArrecadado = pagos.reduce((soma, i) => soma + (Number(i.valor) || 0), 0);
          const taxaComparecimento = totalInscritos ? Math.round((presentes / totalInscritos) * 100) : 0;

          // --- Gráficos das perguntas de seleção (só proporção agregada, nunca lista de respostas) ---
          const resPerguntasSelecao = await fetch(
            `${directusUrl}/items/perguntas_evento?filter[_and][0][evento][_eq]=${eventoId}&filter[_and][1][tipo][_in]=selecao_unica,selecao_multipla&sort=ordem&limit=-1`,
            { headers: { Authorization: `Bearer ${token}` } },
          );
          const perguntasSelecao: { id: number; label: string; opcoes: string[] | null }[] = (await resPerguntasSelecao.json()).data ?? [];

          let graficos: { titulo: string; contagens: ReturnType<typeof contarRespostas> }[] = [];
          if (perguntasSelecao.length) {
            const resRespostas = await fetch(
              `${directusUrl}/items/respostas_inscricao?filter[inscricao][evento][_eq]=${eventoId}&fields=inscricao,pergunta,valor&limit=-1`,
              { headers: { Authorization: `Bearer ${token}` } },
            );
            const respostas: { inscricao: number; pergunta: number; valor: string }[] = (await resRespostas.json()).data ?? [];
            const respostasPorInscricao = new Map<number, { pergunta: number; valor: string }[]>();
            respostas.forEach((r) => {
              const lista = respostasPorInscricao.get(r.inscricao) ?? [];
              lista.push(r);
              respostasPorInscricao.set(r.inscricao, lista);
            });

            graficos = perguntasSelecao.map((p) => {
              const valores = inscritos.map((i) => respostasPorInscricao.get(i.id)?.find((r) => r.pergunta === p.id)?.valor);
              return { titulo: p.label, contagens: contarRespostas(p, valores) };
            });
          }

          const periodoEvento = evento.event_date
            ? evento.end_date && evento.end_date !== evento.event_date
              ? `${evento.event_date} a ${evento.end_date}`
              : evento.event_date
            : "";

          // --- PDF: resumo + fechamento de caixa ---
          const doc = new jsPDF({ unit: "pt", format: "a4" });
          const margem = 56;
          let y = margem;

          doc.setFont("helvetica", "bold");
          doc.setFontSize(18);
          doc.text("Relatório de encerramento", margem, y);
          y += 22;
          doc.setFont("helvetica", "normal");
          doc.setFontSize(12);
          doc.setTextColor(90);
          doc.text(`${evento.title}${periodoEvento ? ` — ${periodoEvento}` : ""}`, margem, y);
          y += 36;
          doc.setTextColor(20);

          doc.setFont("helvetica", "bold");
          doc.setFontSize(13);
          doc.text("Resumo", margem, y);
          y += 20;
          doc.setFont("helvetica", "normal");
          doc.setFontSize(11);
          [
            `Total de inscritos: ${totalInscritos}`,
            `Presentes: ${presentes} (${taxaComparecimento}% de comparecimento)`,
          ].forEach((linha) => {
            doc.text(linha, margem, y);
            y += 18;
          });

          y += 20;
          doc.setFont("helvetica", "bold");
          doc.setFontSize(13);
          doc.text("Fechamento de caixa", margem, y);
          y += 20;
          doc.setFont("helvetica", "normal");
          doc.setFontSize(11);
          [
            `Pagos: ${pagos.length}`,
            `Não pagos: ${naoPagos}`,
            `Valor total arrecadado: R$ ${valorArrecadado.toLocaleString("pt-BR", { minimumFractionDigits: 2 })}`,
          ].forEach((linha) => {
            doc.text(linha, margem, y);
            y += 18;
          });

          const largura = doc.internal.pageSize.getWidth();
          const alturaPagina = doc.internal.pageSize.getHeight();

          if (graficos.length) {
            y += 20;
            doc.setFont("helvetica", "bold");
            doc.setFontSize(13);
            doc.setTextColor(20);
            doc.text("Gráficos das perguntas", margem, y);
            y += 22;

            graficos.forEach(({ titulo, contagens }) => {
              const alturaEstimativa = 16 + contagens.length * 20 + 12;
              if (y + alturaEstimativa > alturaPagina - margem) {
                doc.addPage();
                y = margem;
              }
              y = desenharGraficoBarrasPDF(doc, margem, y, largura - margem * 2, titulo, contagens);
            });
          }

          if (y > alturaPagina - margem - 60) {
            doc.addPage();
            y = margem;
          }
          y += 30;
          const larguraAssinatura = (largura - margem * 2 - 40) / 3;
          ["Presidente", "Secretário(a)", "Tesoureiro(a)"].forEach((cargo, index) => {
            const x = margem + index * (larguraAssinatura + 20);
            doc.line(x, y, x + larguraAssinatura, y);
            doc.setFontSize(10);
            doc.text(cargo, x, y + 14);
          });

          doc.save(`encerramento-${evento.slug ?? eventoId}.pdf`);

          // --- Rascunho de notícia (não publicado) ---
          if (encerrarStatus) encerrarStatus.textContent = "Criando rascunho de notícia…";
          const tituloNoticia = `Realizado: ${evento.title}`;
          await fetch(`${directusUrl}/items/noticias`, {
            method: "POST",
            headers: { Authorization: `Bearer ${token}`, "Content-Type": "application/json" },
            body: JSON.stringify({
              title: tituloNoticia,
              slug: slugify(tituloNoticia),
              excerpt: `${presentes} pessoa${presentes === 1 ? "" : "s"} participaram do evento "${evento.title}".`,
              category: "eventos",
              date: evento.event_date ?? new Date().toISOString().slice(0, 10),
              draft: true,
              featured: false,
              body: [
                `# ${evento.title}`,
                "",
                `Realizado ${periodoEvento ? `em ${periodoEvento}` : "recentemente"}${evento.responsavel ? `, promovido por ${evento.responsavel}` : ""}.`,
                "",
                `${presentes} pessoa${presentes === 1 ? "" : "s"} confirmaram presença, de um total de ${totalInscritos} inscrito${totalInscritos === 1 ? "" : "s"}.`,
                "",
                "_Rascunho gerado automaticamente ao encerrar o evento — revise o texto, adicione fotos e publique quando estiver pronto._",
              ].join("\n"),
            }),
          });

          // --- Remove só o telefone, mantém o resto pra sempre ---
          if (encerrarStatus) encerrarStatus.textContent = "Removendo telefones…";
          await fetch(`${directusUrl}/items/inscricoes_eventos`, {
            method: "PATCH",
            headers: { Authorization: `Bearer ${token}`, "Content-Type": "application/json" },
            body: JSON.stringify({ query: { filter: { evento: { _eq: Number(eventoId) } } }, data: { telefone: null } }),
          });

          if (encerrarStatus) {
            encerrarStatus.textContent =
              "✅ Evento encerrado — relatório baixado, rascunho de notícia criado (revise antes de publicar), telefones removidos.";
          }
        } catch {
          if (encerrarStatus) encerrarStatus.textContent = "Não foi possível encerrar agora. Tente novamente.";
        }
      });

      document.querySelector("[data-excluir-evento]")?.addEventListener("click", async () => {
        const excluirStatus = document.querySelector<HTMLElement>("[data-excluir-status]");
        if (!confirm(`Excluir "${evento.title}" e todas as inscrições? Essa ação não pode ser desfeita.`)) return;
        if (excluirStatus) excluirStatus.textContent = "Excluindo…";

        try {
          const inscricoesRes = await fetch(`${directusUrl}/items/inscricoes_eventos?filter[evento][_eq]=${eventoId}&fields=id&limit=-1`, {
            headers: { Authorization: `Bearer ${token}` },
          });
          const inscricoesIds: number[] = ((await inscricoesRes.json()).data ?? []).map((i: { id: number }) => i.id);

          if (inscricoesIds.length) {
            const respostasRes = await fetch(
              `${directusUrl}/items/respostas_inscricao?filter[inscricao][_in]=${inscricoesIds.join(",")}&fields=id&limit=-1`,
              { headers: { Authorization: `Bearer ${token}` } },
            );
            const respostasIds: number[] = ((await respostasRes.json()).data ?? []).map((r: { id: number }) => r.id);
            if (respostasIds.length) {
              await fetch(`${directusUrl}/items/respostas_inscricao`, {
                method: "DELETE",
                headers: { Authorization: `Bearer ${token}`, "Content-Type": "application/json" },
                body: JSON.stringify(respostasIds),
              });
            }
            await fetch(`${directusUrl}/items/inscricoes_eventos`, {
              method: "DELETE",
              headers: { Authorization: `Bearer ${token}`, "Content-Type": "application/json" },
              body: JSON.stringify(inscricoesIds),
            });
          }

          const perguntasRes = await fetch(`${directusUrl}/items/perguntas_evento?filter[evento][_eq]=${eventoId}&fields=id&limit=-1`, {
            headers: { Authorization: `Bearer ${token}` },
          });
          const perguntasIds: number[] = ((await perguntasRes.json()).data ?? []).map((p: { id: number }) => p.id);
          if (perguntasIds.length) {
            await fetch(`${directusUrl}/items/perguntas_evento`, {
              method: "DELETE",
              headers: { Authorization: `Bearer ${token}`, "Content-Type": "application/json" },
              body: JSON.stringify(perguntasIds),
            });
          }

          await fetch(`${directusUrl}/items/eventos/${eventoId}`, {
            method: "DELETE",
            headers: { Authorization: `Bearer ${token}` },
          });

          window.location.href = "/painel-eventos/";
        } catch {
          if (excluirStatus) excluirStatus.textContent = "Não foi possível excluir agora. Tente novamente.";
        }
      });

      form?.addEventListener("submit", async (event) => {
        event.preventDefault();
        if (!statusEl) return;
        statusEl.textContent = "Salvando…";
        try {
          const dadosForm = lerFormulario();
          const vagasAntes = evento.vagas_limite;
          const res = await fetch(`${directusUrl}/items/eventos/${eventoId}`, {
            method: "PATCH",
            headers: { Authorization: `Bearer ${token}`, "Content-Type": "application/json" },
            body: JSON.stringify(dadosForm),
          });
          if (!res.ok) throw new Error("falha ao salvar");
          evento.vagas_limite = dadosForm.vagas_limite;

          // Se o limite de vagas aumentou (ou virou ilimitado), promove quem
          // está na lista de espera — mais antigo primeiro — até preencher
          // as vagas novas.
          let promovidos = 0;
          const limiteNovo = dadosForm.vagas_limite;
          const abriuMaisVagas = limiteNovo === null || (vagasAntes !== null && limiteNovo > vagasAntes);
          if (abriuMaisVagas) {
            const resConfirmados = await fetch(
              `${directusUrl}/items/inscricoes_eventos?aggregate[count]=id&filter[_and][0][evento][_eq]=${eventoId}&filter[_and][1][aguardando_vaga][_eq]=false`,
              { headers: { Authorization: `Bearer ${token}` } },
            );
            const confirmados = Number((await resConfirmados.json()).data?.[0]?.count?.id ?? 0);
            const vagasNovas = limiteNovo === null ? Infinity : limiteNovo - confirmados;

            if (vagasNovas > 0) {
              const resEspera = await fetch(
                `${directusUrl}/items/inscricoes_eventos?filter[_and][0][evento][_eq]=${eventoId}&filter[_and][1][aguardando_vaga][_eq]=true&sort=date_created&fields=id&limit=${
                  vagasNovas === Infinity ? -1 : vagasNovas
                }`,
                { headers: { Authorization: `Bearer ${token}` } },
              );
              const emEspera: { id: number }[] = (await resEspera.json()).data ?? [];
              if (emEspera.length) {
                await fetch(`${directusUrl}/items/inscricoes_eventos`, {
                  method: "PATCH",
                  headers: { Authorization: `Bearer ${token}`, "Content-Type": "application/json" },
                  body: JSON.stringify({ keys: emEspera.map((i) => i.id), data: { aguardando_vaga: false } }),
                });
                promovidos = emEspera.length;
              }
            }
          }

          statusEl.textContent = promovidos
            ? `✅ Evento salvo! ${promovidos} pessoa${promovidos === 1 ? "" : "s"} da lista de espera foi${promovidos === 1 ? "" : "ram"} confirmada${promovidos === 1 ? "" : "s"}.`
            : "✅ Evento salvo!";
        } catch {
          statusEl.textContent = "Não foi possível salvar agora.";
        }
      });

      document.querySelector("[data-novo-tipo]")?.addEventListener("change", (event) => {
        const select = event.target as HTMLSelectElement;
        const opcoesEl = document.querySelector<HTMLTextAreaElement>("[data-novo-opcoes]");
        if (opcoesEl) opcoesEl.hidden = select.value !== "selecao_unica" && select.value !== "selecao_multipla";
      });

      document.querySelector("[data-adicionar-pergunta]")?.addEventListener("click", async () => {
        const labelEl = document.querySelector<HTMLInputElement>("[data-novo-label]");
        const tipoEl = document.querySelector<HTMLSelectElement>("[data-novo-tipo]");
        const opcoesEl = document.querySelector<HTMLTextAreaElement>("[data-novo-opcoes]");
        const obrigatoriaEl = document.querySelector<HTMLInputElement>("[data-novo-obrigatoria]");
        const momentoEl = document.querySelector<HTMLSelectElement>("[data-novo-momento]");
        if (!labelEl?.value.trim()) return;

        const opcoes = opcoesEl?.value
          .split("\n")
          .map((linha) => linha.trim())
          .filter(Boolean);

        await fetch(`${directusUrl}/items/perguntas_evento`, {
          method: "POST",
          headers: { Authorization: `Bearer ${token}`, "Content-Type": "application/json" },
          body: JSON.stringify({
            evento: eventoId,
            label: labelEl.value.trim(),
            tipo: tipoEl?.value,
            opcoes: opcoes?.length ? opcoes : null,
            obrigatoria: Boolean(obrigatoriaEl?.checked),
            momento: momentoEl?.value || "inscricao",
            ordem: 99,
          }),
        });

        labelEl.value = "";
        if (opcoesEl) opcoesEl.value = "";
        if (obrigatoriaEl) obrigatoriaEl.checked = false;
        if (momentoEl) momentoEl.value = "inscricao";
        await carregarPerguntas(token, eventoId);
      });

      perguntasLista?.addEventListener("click", async (event) => {
        const target = event.target as HTMLElement;
        const card = target.closest<HTMLElement>("[data-pergunta-id]");
        if (!card) return;
        const perguntaId = card.dataset.perguntaId;

        if (target.matches("[data-excluir-pergunta]")) {
          if (!confirm("Excluir essa pergunta?")) return;
          await fetch(`${directusUrl}/items/perguntas_evento/${perguntaId}`, {
            method: "DELETE",
            headers: { Authorization: `Bearer ${token}` },
          });
          await carregarPerguntas(token, eventoId);
          return;
        }

        if (target.matches("[data-salvar-pergunta]")) {
          const labelInput = card.querySelector<HTMLInputElement>('[data-campo="label"]');
          const tipoSelect = card.querySelector<HTMLSelectElement>('[data-campo="tipo"]');
          const ordemInput = card.querySelector<HTMLInputElement>('[data-campo="ordem"]');
          const opcoesTextarea = card.querySelector<HTMLTextAreaElement>('[data-campo="opcoes"]');
          const obrigatoriaInput = card.querySelector<HTMLInputElement>('[data-campo="obrigatoria"]');
          const momentoSelect = card.querySelector<HTMLSelectElement>('[data-campo="momento"]');

          const opcoes = opcoesTextarea?.value
            .split("\n")
            .map((linha) => linha.trim())
            .filter(Boolean);

          await fetch(`${directusUrl}/items/perguntas_evento/${perguntaId}`, {
            method: "PATCH",
            headers: { Authorization: `Bearer ${token}`, "Content-Type": "application/json" },
            body: JSON.stringify({
              label: labelInput?.value.trim(),
              tipo: tipoSelect?.value,
              ordem: ordemInput?.value ? Number(ordemInput.value) : 0,
              opcoes: opcoes?.length ? opcoes : null,
              obrigatoria: Boolean(obrigatoriaInput?.checked),
              momento: momentoSelect?.value || "inscricao",
            }),
          });
          await carregarPerguntas(token, eventoId);
        }
      });

      perguntasLista?.addEventListener("change", (event) => {
        const target = event.target as HTMLElement;
        if (!target.matches('[data-campo="tipo"]')) return;
        const card = target.closest<HTMLElement>("[data-pergunta-id]");
        const opcoesTextarea = card?.querySelector<HTMLTextAreaElement>('[data-campo="opcoes"]');
        const valor = (target as HTMLSelectElement).value;
        if (opcoesTextarea) opcoesTextarea.hidden = valor !== "selecao_unica" && valor !== "selecao_multipla";
      });
    }

    iniciar();
  </script>

  <style is:global>
    .zona-encerrar {
      border: 1px solid var(--border-strong);
      border-radius: var(--radius-md);
      padding: 1.1rem 1.25rem;
      max-width: 40rem;
      background: var(--muted);
    }

    .zona-perigo {
      border: 1px solid color-mix(in srgb, #b3261e 35%, var(--border));
      border-radius: var(--radius-md);
      padding: 1.1rem 1.25rem;
      max-width: 40rem;
    }

    .btn-excluir-evento {
      border-color: #b3261e;
      color: #b3261e;
    }

    .btn-excluir-evento:hover {
      background: color-mix(in srgb, #b3261e 10%, transparent);
    }

    .evento-canvas {
      max-width: 48rem;
    }

    .pergunta-card {
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      padding: 1.1rem 1.25rem;
    }

    .ordem-input {
      max-width: 5rem;
    }

    .faixa-valor {
      max-width: 7rem;
    }
  </style>
</BaseLayout>
