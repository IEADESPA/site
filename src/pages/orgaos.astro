---
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig } from "@/config/site";
import { getAllMensagens, visiblePosts } from "@/lib/posts";
import { fetchItems } from "@/lib/directus";

interface Orgao {
  slug: string;
  name: string;
  description: string;
  category: "governanca" | "departamentos" | "secretarias" | "servicos";
}

const CATEGORIES: { value: Orgao["category"]; label: string; description: string }[] = [
  {
    value: "governanca",
    label: "Governança",
    description: "Assembleia, ministério geral e conselhos que deliberam sobre a condução da igreja.",
  },
  {
    value: "departamentos",
    label: "Departamentos",
    description: "Grupos organizados por faixa etária e perfil: crianças, jovens, senhoras e homens.",
  },
  {
    value: "secretarias",
    label: "Secretarias",
    description: "Missões, ação social, família e escola bíblica.",
  },
  {
    value: "servicos",
    label: "Serviços",
    description: "Louvor, adoração e demais equipes que servem diretamente nos cultos.",
  },
];

const allPosts = visiblePosts(await getAllMensagens());
const orgaos = await fetchItems<Orgao>("ministerios", "sort[]=sort");
const groups = CATEGORIES.map((category) => ({
  ...category,
  items: orgaos.filter((orgao) => orgao.category === category.value),
})).filter((group) => group.items.length > 0);
---

<BaseLayout
  title="Órgãos"
  description={`Conselhos, departamentos e secretarias da ${siteConfig.name}.`}
>
  <SiteHeader posts={allPosts} />
  <main id="content" class="outer">
    <div class="canvas">
      <header class="pagehead">
        <p class="eyebrow">Servindo juntos</p>
        <h1 class="pagehead-title">Órgãos</h1>
        <p class="pagehead-description">
          Conselhos, departamentos e secretarias que deliberam nas assembleias e reuniões da
          igreja. Cada órgão existe para servir à igreja e à comunidade de uma forma específica —
          há espaço para você servir com os dons que Deus lhe deu.
        </p>
      </header>

      <nav class="orgao-tabs" aria-label="Categorias de órgãos">
        <button type="button" class="orgao-tab is-active" data-orgao-tab="todos">Todos</button>
        {
          groups.map((group) => (
            <button type="button" class="orgao-tab" data-orgao-tab={group.value}>
              {group.label}
            </button>
          ))
        }
      </nav>

      {
        groups.map((group) => (
          <section class="orgao-group" data-orgao-group={group.value}>
            <h2 class="section-title">{group.label}</h2>
            <p class="mt-1 text-sm text-muted-foreground">{group.description}</p>
            <ul class="mt-5 grid gap-6 sm:grid-cols-2">
              {group.items.map((orgao) => (
                <li class="orgao-card">
                  <h3 class="text-lg font-semibold tracking-tight">{orgao.name}</h3>
                  <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{orgao.description}</p>
                  <a href={`/orgao/${orgao.slug}/`} class="mt-3 inline-block link-sweep text-sm font-semibold text-accent">
                    Saiba mais
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }

      <div class="prose mt-16">
        <h2>Quer participar?</h2>
        <p>
          Fale com a liderança em um dos nossos cultos ou entre em contato pela{" "}
          <a href="/contato/">página de contato</a> para saber como se envolver em um dos órgãos da
          igreja.
        </p>
      </div>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>

<script is:inline>
  (() => {
    const tabs = document.querySelectorAll("[data-orgao-tab]");
    const groups = document.querySelectorAll("[data-orgao-group]");

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const target = tab.getAttribute("data-orgao-tab");

        tabs.forEach((t) => t.classList.toggle("is-active", t === tab));
        groups.forEach((group) => {
          const match = target === "todos" || group.getAttribute("data-orgao-group") === target;
          group.hidden = !match;
        });
      });
    });
  })();
</script>

<style>
  .orgao-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 2.5rem;
  }

  .orgao-tab {
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    padding: 0.45rem 1.1rem;
    color: var(--muted-foreground);
    font-size: 0.875rem;
    font-weight: 600;
    background: transparent;
    transition:
      border-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out);
  }

  .orgao-tab:hover {
    border-color: color-mix(in srgb, var(--accent) 45%, var(--border));
    color: var(--accent);
  }

  .orgao-tab.is-active {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--accent-foreground);
  }

  .orgao-group + .orgao-group {
    margin-top: 3rem;
  }

  .orgao-card {
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 1.5rem 1.6rem;
  }
</style>
