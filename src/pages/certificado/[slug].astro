---
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig } from "@/config/site";
import { DIRECTUS_URL, fetchItems } from "@/lib/directus";
import { getAllMensagens, visiblePosts } from "@/lib/posts";

interface Evento {
  id: number;
  slug: string;
  title: string;
  event_date: string | null;
  end_date: string | null;
  aceita_inscricao: boolean;
}

export async function getStaticPaths() {
  const events = await fetchItems<Evento>("eventos", "filter[aceita_inscricao][_eq]=true");
  return events.map((event) => ({ params: { slug: event.slug }, props: { event } }));
}

interface Props {
  event: Evento;
}

const { event } = Astro.props;
const allPosts = visiblePosts(await getAllMensagens());

const dateFormatter = new Intl.DateTimeFormat(siteConfig.dateLocale, { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" });
const periodoEvento = event.event_date
  ? event.end_date && event.end_date !== event.event_date
    ? `${dateFormatter.format(new Date(event.event_date))} a ${dateFormatter.format(new Date(event.end_date))}`
    : dateFormatter.format(new Date(event.event_date))
  : "";
---

<BaseLayout title={`Certificado — ${event.title}`} description="Baixe seu certificado de participação no evento." noindex>
  <SiteHeader posts={allPosts} />
  <main id="content" class="outer">
    <div class="canvas certificado-canvas">
      <header class="pagehead">
        <p class="eyebrow">Certificado</p>
        <h1 class="pagehead-title">{event.title}</h1>
        <p class="pagehead-description">
          Digite o mesmo código usado no check-in do evento pra baixar seu certificado de
          participação.
        </p>
      </header>

      <form
        class="mt-8 grid gap-4 max-w-sm"
        data-certificado-form
        data-evento-id={event.id}
        data-evento-titulo={event.title}
        data-evento-periodo={periodoEvento}
        data-directus-url={DIRECTUS_URL}
      >
        <div class="grid gap-2">
          <label class="text-sm font-semibold" for="certificado-codigo">Código de confirmação</label>
          <input
            id="certificado-codigo"
            name="codigo"
            type="text"
            autocomplete="off"
            autocapitalize="characters"
            maxlength="6"
            class="field certificado-codigo-input"
            placeholder="A3F9K2"
          />
        </div>
        <button type="submit" class="btn btn-solid">Buscar certificado</button>
      </form>

      <p class="mt-6 text-lg font-semibold" data-certificado-resultado role="status" aria-live="polite" />
    </div>
  </main>
  <SiteFooter />

  <script>
    import { jsPDF } from "jspdf";

    const form = document.querySelector<HTMLFormElement>("[data-certificado-form]");
    if (!form) throw new Error("formulário de certificado ausente");

    const eventoId = form.dataset.eventoId;
    const eventoTitulo = form.dataset.eventoTitulo ?? "";
    const eventoPeriodo = form.dataset.eventoPeriodo ?? "";
    const directusUrl = form.dataset.directusUrl ?? "";
    const resultado = document.querySelector<HTMLElement>("[data-certificado-resultado]");
    const codigoInput = document.getElementById("certificado-codigo") as HTMLInputElement;

    const siteFullName = "Igreja Evangélica Assembleia de Deus Ministério do Seta em Parauapebas/PA";

    let logoDataUrl: string | null = null;
    async function carregarLogo(): Promise<string | null> {
      if (logoDataUrl) return logoDataUrl;
      try {
        const res = await fetch("/logo-icon.png");
        const blob = await res.blob();
        logoDataUrl = await new Promise<string>((resolve, reject) => {
          const reader = new FileReader();
          reader.onload = () => resolve(reader.result as string);
          reader.onerror = reject;
          reader.readAsDataURL(blob);
        });
        return logoDataUrl;
      } catch {
        return null;
      }
    }

    async function gerarCertificado(nome: string) {
      const logo = await carregarLogo();
      const doc = new jsPDF({ unit: "pt", format: "a4", orientation: "landscape" });
      const largura = doc.internal.pageSize.getWidth();
      const altura = doc.internal.pageSize.getHeight();
      const margem = 28;

      const OURO: [number, number, number] = [217, 179, 79];
      const MARINHO: [number, number, number] = [15, 27, 51];
      const CINZA: [number, number, number] = [90, 98, 112];

      // Fundo e moldura dupla dourada.
      doc.setFillColor(250, 248, 242);
      doc.rect(0, 0, largura, altura, "F");
      doc.setDrawColor(...OURO);
      doc.setLineWidth(2.5);
      doc.rect(margem, margem, largura - margem * 2, altura - margem * 2);
      doc.setLineWidth(0.75);
      doc.rect(margem + 8, margem + 8, largura - (margem + 8) * 2, altura - (margem + 8) * 2);

      if (logo) doc.addImage(logo, "PNG", largura / 2 - 26, margem + 48, 52, 52);

      doc.setTextColor(...MARINHO);
      doc.setFont("times", "bold");
      doc.setFontSize(38);
      doc.text("CERTIFICADO", largura / 2, margem + 155, { align: "center" });

      doc.setDrawColor(...OURO);
      doc.setLineWidth(1);
      doc.line(largura / 2 - 60, margem + 168, largura / 2 + 60, margem + 168);

      doc.setFont("helvetica", "normal");
      doc.setFontSize(13);
      doc.setTextColor(...CINZA);
      doc.text(`A ${siteFullName} certifica que`, largura / 2, margem + 205, { align: "center" });

      doc.setFont("times", "bold");
      doc.setFontSize(30);
      doc.setTextColor(...OURO);
      doc.text(nome.toUpperCase(), largura / 2, margem + 260, { align: "center", maxWidth: largura - margem * 4 });

      doc.setFont("helvetica", "normal");
      doc.setFontSize(14);
      doc.setTextColor(...MARINHO);
      const corpo = `participou do evento "${eventoTitulo}"${eventoPeriodo ? `, realizado em ${eventoPeriodo}` : ""}.`;
      const linhas = doc.splitTextToSize(corpo, largura - margem * 5);
      doc.text(linhas, largura / 2, margem + 305, { align: "center" });

      doc.setDrawColor(...OURO);
      doc.setLineWidth(0.75);
      doc.line(largura / 2 - 90, altura - margem - 62, largura / 2 + 90, altura - margem - 62);

      doc.setFontSize(11);
      doc.setTextColor(...CINZA);
      doc.text(`Emitido em ${new Date().toLocaleDateString("pt-BR")}`, largura / 2, altura - margem - 40, { align: "center" });
      doc.setFont("helvetica", "bold");
      doc.text("IEADESPA", largura / 2, altura - margem - 24, { align: "center" });

      doc.save(`certificado-${nome.toLowerCase().replace(/\s+/g, "-")}.pdf`);
    }

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const codigo = codigoInput.value.trim().toUpperCase();
      if (!resultado) return;
      resultado.textContent = "Verificando…";

      try {
        const res = await fetch(
          `${directusUrl}/items/inscricoes_eventos?filter[_and][0][evento][_eq]=${eventoId}&filter[_and][1][codigo][_eq]=${encodeURIComponent(codigo)}`,
        );
        const json = await res.json();
        const pessoa = json.data?.[0];

        if (!pessoa) {
          resultado.textContent = "Código não encontrado. Confira e tente de novo.";
          return;
        }
        if (!pessoa.presente) {
          resultado.textContent = "Ainda não encontramos sua confirmação de presença nesse evento.";
          return;
        }

        resultado.textContent = "Gerando certificado…";
        await gerarCertificado(pessoa.nome);
        resultado.textContent = `✅ Certificado de ${pessoa.nome} baixado!`;
      } catch {
        resultado.textContent = "Não foi possível buscar agora. Tente novamente em instantes.";
      }
    });
  </script>

  <style>
    .certificado-canvas {
      max-width: 40rem;
    }

    .certificado-codigo-input {
      text-transform: uppercase;
      letter-spacing: 0.2em;
      font-size: 1.5rem;
      text-align: center;
      font-family: var(--font-mono);
    }
  </style>
</BaseLayout>
