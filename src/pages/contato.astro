---
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig } from "@/config/site";
import { getAllMensagens, visiblePosts } from "@/lib/posts";

const allPosts = visiblePosts(await getAllMensagens());
const contact = siteConfig.contact;
const action = contact.action.trim();
const isEnabled = contact.enabled;
/* Sem endpoint configurado: o formulário permanece utilizável e confirma o
   envio localmente em vez de enviar a página para lugar nenhum. */
const isDemo = isEnabled && action.length === 0;
const mapsEmbedSrc = `https://www.google.com/maps?q=${encodeURIComponent(siteConfig.address.mapsQuery)}&output=embed`;
const mapsLinkHref = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(siteConfig.address.mapsQuery)}`;
---

<BaseLayout title="Contato" description={`Fale com a ${siteConfig.name} e veja como chegar até nós.`}>
  <SiteHeader posts={allPosts} />
  <main id="content" class="outer">
    <div class="canvas">
      <header class="pagehead">
        <p class="eyebrow">Contato</p>
        <h1 class="pagehead-title">Fale conosco</h1>
        <p class="pagehead-description">
          Dúvidas, pedidos de oração e visitas caem na mesma caixa de entrada. {contact.responseTime}
        </p>
      </header>

      <div class="grid gap-10 md:grid-cols-2">
        <div>
          <h2 class="section-title">Endereço</h2>
          <p class="text-sm leading-relaxed text-muted-foreground">{siteConfig.address.full}</p>
          <a href={mapsLinkHref} target="_blank" rel="noreferrer" class="mt-3 inline-block link-sweep text-sm font-semibold text-accent">
            Ver rota no Google Maps
          </a>

          <h2 class="section-title mt-10">Horários de culto</h2>
          <ul class="grid gap-3">
            {
              siteConfig.serviceTimes.map((service) => (
                <li class="flex items-baseline justify-between gap-4 border-b border-border pb-3">
                  <span>
                    <span class="block font-semibold">{service.label}</span>
                    <span class="block text-sm text-muted-foreground">{service.day}</span>
                  </span>
                  <span class="pill shrink-0">{service.time}</span>
                </li>
              ))
            }
          </ul>

          <h2 class="section-title mt-10">Outros contatos</h2>
          <ul class="grid gap-2 text-sm text-muted-foreground">
            {
              siteConfig.email && (
                <li>
                  E-mail: <a href={`mailto:${siteConfig.email}`} class="text-accent underline underline-offset-2">{siteConfig.email}</a>
                </li>
              )
            }
            <li>
              Instagram: <a href="https://instagram.com/adsetaparauapebas" target="_blank" rel="noreferrer" class="text-accent underline underline-offset-2">@adsetaparauapebas</a>
            </li>
          </ul>

          <div class="mt-8 overflow-hidden rounded-[var(--radius-md)] border border-border">
            <iframe
              title="Mapa com a localização da igreja"
              src={mapsEmbedSrc}
              width="100%"
              height="280"
              style="border:0"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
            ></iframe>
          </div>
        </div>

        <form
          class="grid gap-5"
          action={action || undefined}
          method={contact.method}
          data-contact-form={isDemo ? "" : undefined}
        >
          <h2 class="section-title">Envie uma mensagem</h2>

          <div class="grid gap-2">
            <label class="text-sm font-semibold" for="contact-name">Nome</label>
            <input id="contact-name" name="name" type="text" autocomplete="name" required disabled={!isEnabled} class="field" />
          </div>

          <div class="grid gap-2">
            <label class="text-sm font-semibold" for="contact-email">E-mail</label>
            <input id="contact-email" name="email" type="email" autocomplete="email" required disabled={!isEnabled} class="field" />
          </div>

          <div class="grid gap-2">
            <label class="text-sm font-semibold" for="contact-message">Mensagem</label>
            <textarea id="contact-message" name="message" rows="7" required disabled={!isEnabled} class="field resize-y"></textarea>
          </div>

          <div class="flex flex-wrap items-center gap-4">
            <button type="submit" disabled={!isEnabled} class="btn btn-solid">
              {isEnabled ? "Enviar mensagem" : "Formulário indisponível"}
            </button>
            <p class="contact-status text-sm leading-relaxed text-muted-foreground" role="status" aria-live="polite" data-contact-status></p>
          </div>

          {
            !isEnabled && (
              <p class="text-sm leading-relaxed text-muted-foreground">
                Este formulário está desativado até que um endpoint seja configurado em <code>siteConfig.contact</code>.
              </p>
            )
          }
        </form>
      </div>
    </div>
  </main>
  <SiteFooter />

  {
    isDemo && (
      <script is:inline>
        document.querySelectorAll("[data-contact-form]").forEach((form) => {
          form.addEventListener("submit", (event) => {
            event.preventDefault();
            const status = form.querySelector("[data-contact-status]");
            if (status) {
              status.textContent =
                "Obrigado. Este formulário de demonstração ainda não está conectado a um endpoint, então nada foi enviado.";
            }
            form.reset();
          });
        });
      </script>
    )
  }

  <style>
    .contact-status:empty {
      display: none;
    }
  </style>
</BaseLayout>
