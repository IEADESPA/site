---
import ProgramacaoList from "@/components/ProgramacaoList.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig } from "@/config/site";
import { getAllMensagens, visiblePosts } from "@/lib/posts";
import { DIRECTUS_URL, enderecoCompleto, enderecoMapsQuery, fetchConfiguracoes, mapsHref } from "@/lib/directus";
import { churchStructuredData, getAllProgramacao, sedeProgramacao } from "@/lib/programacao";

const allPosts = visiblePosts(await getAllMensagens());
const config = await fetchConfiguracoes();
const sedeSchedule = sedeProgramacao(await getAllProgramacao());
const structuredData = churchStructuredData(config, sedeSchedule, siteConfig.siteUrl, siteConfig.name);
const contact = siteConfig.contact;
const instagram = siteConfig.socials.find((social) => social.label === "Instagram");
const isEnabled = contact.enabled;
/* A pré-visualização em iframe só funciona com uma busca por endereço (é o
   formato de embed sem chave de API do Google) — o link "Ver rota", esse
   sim, aponta para o perfil real da igreja no Google Maps quando cadastrado. */
const mapsEmbedSrc = `https://www.google.com/maps?q=${encodeURIComponent(enderecoMapsQuery(config))}&output=embed`;
const mapsLinkHref = mapsHref(config);
---

<BaseLayout
  title="Contato"
  description={`Fale com a ${siteConfig.name} e veja como chegar até nós.`}
  structuredData={structuredData}
>
  <SiteHeader posts={allPosts} />
  <main id="content" class="outer">
    <div class="canvas">
      <header class="pagehead">
        <p class="eyebrow">Contato</p>
        <h1 class="pagehead-title">Fale conosco</h1>
        <p class="pagehead-description">
          Dúvidas, pedidos de oração e visitas pastorais — escolha o assunto para chegar direto a
          quem cuida disso. {contact.responseTime}
        </p>
      </header>

      <div class="grid gap-10 md:grid-cols-2">
        <div>
          <h2 class="section-title">Endereço</h2>
          <p class="text-sm leading-relaxed text-muted-foreground">{enderecoCompleto(config)}</p>
          <div class="mt-3 flex flex-wrap gap-4">
            <a href={mapsLinkHref} target="_blank" rel="noreferrer" class="link-sweep text-sm font-semibold text-accent">
              Ver rota no Google Maps
            </a>
            <a href="/ieadespa.vcf" class="link-sweep text-sm font-semibold text-accent">
              Adicionar aos contatos
            </a>
          </div>

          <h2 class="section-title mt-10">Horários de culto</h2>
          <div class="mt-3">
            <ProgramacaoList items={sedeSchedule} showScope={false} />
          </div>

          <h2 class="section-title mt-10">Outros contatos</h2>
          <ul class="grid gap-2 text-sm text-muted-foreground">
            {
              siteConfig.email && (
                <li>
                  E-mail: <a href={`mailto:${siteConfig.email}`} class="text-accent underline underline-offset-2">{siteConfig.email}</a>
                </li>
              )
            }
            {
              config.phone && (
                <li>
                  WhatsApp/Telefone: <a href={`https://wa.me/${config.phone.replace(/\D/g, "")}`} target="_blank" rel="noreferrer" class="text-accent underline underline-offset-2">{config.phone}</a>
                </li>
              )
            }
            {
              instagram && (
                <li>
                  Instagram: <a href={instagram.href} target="_blank" rel="noreferrer" class="text-accent underline underline-offset-2">@{instagram.href.split("/").filter(Boolean).pop()}</a>
                </li>
              )
            }
          </ul>

          <div class="mt-8 overflow-hidden rounded-[var(--radius-md)] border border-border">
            <iframe
              title="Mapa com a localização da igreja"
              src={mapsEmbedSrc}
              width="100%"
              height="280"
              style="border:0"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
            ></iframe>
          </div>
        </div>

        <form id="fale-conosco" class="grid gap-5" data-contact-form={isEnabled ? "" : undefined}>
          <h2 class="section-title" data-contact-heading>Envie uma mensagem</h2>

          <div class="grid gap-2">
            <label class="text-sm font-semibold" for="contact-type">Assunto</label>
            <select id="contact-type" name="type" disabled={!isEnabled} class="field" data-contact-type>
              <option value="duvida">Dúvida geral</option>
              <option value="oracao">Pedido de oração</option>
              <option value="visita">Visita pastoral</option>
              <option value="outro">Outro assunto</option>
            </select>
          </div>

          <p class="contact-privacy-note" data-contact-privacy hidden>
            Só a diretoria e a liderança pastoral têm acesso aos pedidos de oração — nada é
            publicado no site nem visto por outros visitantes.
          </p>

          <div class="grid gap-2" data-contact-anon-field hidden>
            <label class="contact-checkbox">
              <input type="checkbox" name="anonymous" id="contact-anonymous" data-contact-anonymous />
              Prefiro enviar de forma anônima (sem nome nem e-mail)
            </label>
          </div>

          <div class="grid gap-2" data-contact-name-field>
            <label class="text-sm font-semibold" for="contact-name" data-contact-name-label>Nome</label>
            <input id="contact-name" name="name" type="text" autocomplete="name" required disabled={!isEnabled} class="field" />
          </div>

          <div class="grid gap-2" data-contact-email-field>
            <label class="text-sm font-semibold" for="contact-email" data-contact-email-label>E-mail</label>
            <input id="contact-email" name="email" type="email" autocomplete="email" required disabled={!isEnabled} class="field" />
          </div>

          <div class="grid gap-2">
            <label class="text-sm font-semibold" for="contact-message" data-contact-message-label>Mensagem</label>
            <textarea
              id="contact-message"
              name="message"
              rows="7"
              required
              disabled={!isEnabled}
              class="field resize-y"
              data-contact-message
            ></textarea>
          </div>

          <div class="flex flex-wrap items-center gap-4">
            <button type="submit" disabled={!isEnabled} class="btn btn-solid" data-contact-submit>
              {isEnabled ? "Enviar mensagem" : "Formulário indisponível"}
            </button>
            <p class="contact-status text-sm leading-relaxed text-muted-foreground" role="status" aria-live="polite" data-contact-status></p>
          </div>

          {
            !isEnabled && (
              <p class="text-sm leading-relaxed text-muted-foreground">
                Este formulário está desativado. Ative em <code>siteConfig.contact.enabled</code>.
              </p>
            )
          }
        </form>
      </div>
    </div>
  </main>
  <SiteFooter />

  {
    isEnabled && (
      <script is:inline define:vars={{ directusUrl: DIRECTUS_URL }}>
        document.querySelectorAll("[data-contact-form]").forEach((form) => {
          const typeSelect = form.querySelector("[data-contact-type]");
          const heading = form.querySelector("[data-contact-heading]");
          const privacyNote = form.querySelector("[data-contact-privacy]");
          const anonField = form.querySelector("[data-contact-anon-field]");
          const anonCheckbox = form.querySelector("[data-contact-anonymous]");
          const nameField = form.querySelector("[data-contact-name-field]");
          const emailField = form.querySelector("[data-contact-email-field]");
          const nameInput = form.querySelector("#contact-name");
          const emailInput = form.querySelector("#contact-email");
          const nameLabel = form.querySelector("[data-contact-name-label]");
          const messageLabel = form.querySelector("[data-contact-message-label]");
          const messageField = form.querySelector("[data-contact-message]");
          const submitButton = form.querySelector("[data-contact-submit]");

          /* O assunto "Pedido de oração" muda o próprio formulário: título,
             rótulos, um aviso de confidencialidade e a opção de enviar sem
             se identificar — em vez de só mais uma opção num dropdown. */
          const applyType = () => {
            const isOracao = typeSelect?.value === "oracao";
            const isAnon = isOracao && anonCheckbox instanceof HTMLInputElement && anonCheckbox.checked;

            if (heading) heading.textContent = isOracao ? "Envie seu pedido de oração" : "Envie uma mensagem";
            if (privacyNote) privacyNote.hidden = !isOracao;
            if (anonField) anonField.hidden = !isOracao;
            if (messageLabel) messageLabel.textContent = isOracao ? "Seu pedido de oração" : "Mensagem";
            if (nameLabel) nameLabel.textContent = isOracao ? "Nome (opcional se enviar anônimo)" : "Nome";
            if (messageField) {
              messageField.placeholder = isOracao
                ? "Conte com suas palavras o que você gostaria que a igreja orasse."
                : "";
            }
            if (submitButton) submitButton.textContent = isOracao ? "Enviar pedido de oração" : "Enviar mensagem";

            if (nameField) nameField.hidden = isAnon;
            if (emailField) emailField.hidden = isAnon;
            if (nameInput) nameInput.required = !isAnon;
            if (emailInput) emailInput.required = !isAnon;
          };

          typeSelect?.addEventListener("change", applyType);
          anonCheckbox?.addEventListener("change", applyType);

          /* Um link tipo /contato/?assunto=oracao#fale-conosco já chega com o
             assunto certo escolhido, sem a pessoa precisar procurar. */
          const requestedType = new URLSearchParams(window.location.search).get("assunto");
          if (requestedType && typeSelect) typeSelect.value = requestedType;
          applyType();

          form.addEventListener("submit", async (event) => {
            event.preventDefault();
            const status = form.querySelector("[data-contact-status]");
            const button = form.querySelector("button[type=submit]");
            const data = new FormData(form);
            const isAnon = anonCheckbox instanceof HTMLInputElement && anonCheckbox.checked && !anonField?.hidden;

            if (button) button.disabled = true;
            if (status) status.textContent = "Enviando…";

            try {
              const payload = {
                name: isAnon ? "Anônimo" : data.get("name"),
                type: data.get("type"),
                message: data.get("message"),
              };
              if (!isAnon) payload.email = data.get("email");

              const response = await fetch(`${directusUrl}/items/contato_mensagens`, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(payload),
              });

              if (!response.ok) throw new Error("request failed");

              if (status) status.textContent = "Mensagem enviada. Obrigado pelo contato!";
              form.reset();
              applyType();
            } catch {
              if (status) {
                status.textContent =
                  "Não foi possível enviar agora. Tente novamente em instantes ou escreva para " +
                  "o e-mail no rodapé desta página.";
              }
            } finally {
              if (button) button.disabled = false;
            }
          });
        });
      </script>
    )
  }

  <style>
    .contact-status:empty {
      display: none;
    }

    .contact-privacy-note {
      margin: 0;
      border-left: 3px solid var(--accent);
      background: var(--muted);
      border-radius: var(--radius-sm);
      padding: 0.75rem 1rem;
      color: var(--muted-foreground);
      font-size: 0.875rem;
      line-height: 1.5;
    }

    .contact-checkbox {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      color: var(--foreground);
      font-size: 0.9375rem;
      cursor: pointer;
    }

    .contact-checkbox input {
      width: 1.1rem;
      height: 1.1rem;
      accent-color: var(--accent);
    }
  </style>
</BaseLayout>
