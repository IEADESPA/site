---
import { getCollection } from "astro:content";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig } from "@/config/site";
import { visiblePosts } from "@/lib/posts";

const allPosts = visiblePosts(await getCollection("posts"));

const ministries = [
  {
    name: "Ministério de Louvor e Adoração",
    description:
      "Conduz a igreja em momentos de louvor e adoração nos cultos, reunindo músicos e vocalistas.",
  },
  {
    name: "Ministério Infantil",
    description:
      "Cuida do ensino bíblico e da recreação das crianças durante os cultos e eventos especiais.",
  },
  {
    name: "Ministério de Jovens",
    description:
      "Reúne os jovens da igreja para comunhão, estudo bíblico e atividades voltadas para essa fase da vida.",
  },
  {
    name: "Ministério de Casais",
    description:
      "Fortalece os casamentos por meio de encontros, aconselhamento e estudos sobre família.",
  },
  {
    name: "Ministério de Evangelismo e Missões",
    description:
      "Organiza ações evangelísticas na cidade e apoia projetos missionários dentro e fora do Brasil.",
  },
  {
    name: "Ministério de Ação Social",
    description:
      "Desenvolve campanhas de doação, visitas e apoio a famílias em situação de necessidade.",
  },
  {
    name: "Ministério de Diaconia",
    description:
      "Auxilia na organização prática dos cultos e no acolhimento de visitantes e membros.",
  },
  {
    name: "Ministério de Ensino",
    description:
      "Responsável pela Escola Bíblica Dominical e por cursos de formação de discípulos.",
  },
];
---

<BaseLayout
  title="Ministérios"
  description={`Conheça os ministérios e departamentos da ${siteConfig.name}.`}
>
  <SiteHeader posts={allPosts} />
  <main id="content" class="outer">
    <div class="canvas">
      <header class="pagehead">
        <p class="eyebrow">Servindo juntos</p>
        <h1 class="pagehead-title">Ministérios</h1>
        <p class="pagehead-description">
          Cada ministério existe para servir à igreja e à comunidade de uma forma específica. Há
          espaço para você servir com os dons que Deus lhe deu.
        </p>
      </header>

      <ul class="grid gap-6 sm:grid-cols-2">
        {
          ministries.map((ministry) => (
            <li class="ministry-card">
              <h2 class="text-lg font-semibold tracking-tight">{ministry.name}</h2>
              <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{ministry.description}</p>
            </li>
          ))
        }
      </ul>

      <div class="prose mt-16">
        <h2>Quer participar?</h2>
        <p>
          Fale com a liderança em um dos nossos cultos ou entre em contato pela{" "}
          <a href="/contato/">página de contato</a> para saber como se envolver em um dos ministérios.
        </p>
      </div>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .ministry-card {
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 1.5rem 1.6rem;
  }
</style>
