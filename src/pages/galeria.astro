---
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig } from "@/config/site";
import { getAllMensagens, visiblePosts } from "@/lib/posts";
import { DIRECTUS_ADMIN_URL, directusAssetUrl, fetchItems } from "@/lib/directus";

interface GaleriaItem {
  photo: string;
  alt: string;
  caption: string | null;
}

const allPosts = visiblePosts(await getAllMensagens());
const photos = (await fetchItems<GaleriaItem>("galeria", "sort[]=sort")).map((item) => ({
  src: directusAssetUrl(item.photo),
  alt: item.alt,
  caption: item.caption,
}));
---

<BaseLayout title="Galeria" description={`Fotos de cultos e eventos da ${siteConfig.name}.`}>
  <SiteHeader posts={allPosts} />
  <main id="content" class="outer">
    <div class="canvas">
      <header class="pagehead">
        <p class="eyebrow">Registros</p>
        <h1 class="pagehead-title">Galeria de fotos</h1>
        <p class="pagehead-description">
          Momentos de cultos, eventos e atividades da igreja.
        </p>
      </header>

      {
        photos.length > 0 ? (
          <ul class="gallery-grid">
            {photos.map((photo) => (
              <li class="gallery-item">
                <img src={photo.src} alt={photo.alt} loading="lazy" />
                {photo.caption && <p class="gallery-caption">{photo.caption}</p>}
              </li>
            ))}
          </ul>
        ) : (
          <div class="gallery-empty">
            <p class="text-sm leading-relaxed text-muted-foreground">
              Ainda não há fotos publicadas. Assim que novas fotos de cultos e eventos forem
              adicionadas pelo <a href={DIRECTUS_ADMIN_URL}>painel administrativo</a>, elas aparecerão aqui.
            </p>
          </div>
        )
      }
    </div>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .gallery-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  @media (min-width: 640px) {
    .gallery-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .gallery-item {
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
  }

  .gallery-item img {
    aspect-ratio: 4 / 3;
    width: 100%;
    object-fit: cover;
  }

  .gallery-caption {
    padding: 0.6rem 0.8rem;
    color: var(--muted-foreground);
    font-size: 0.8125rem;
  }

  .gallery-empty {
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius-md);
    padding: 2.5rem 1.5rem;
    text-align: center;
  }
</style>
