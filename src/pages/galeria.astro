---
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig } from "@/config/site";
import { getAllMensagens, visiblePosts } from "@/lib/posts";
import { DIRECTUS_ADMIN_URL, directusAssetUrl, fetchItems } from "@/lib/directus";

interface GaleriaItem {
  photo: string;
  alt: string;
  caption: string | null;
}

const allPosts = visiblePosts(await getAllMensagens());
const photos = (await fetchItems<GaleriaItem>("galeria", "sort[]=sort")).map((item) => ({
  src: directusAssetUrl(item.photo, { width: 640, quality: 72, format: "webp", fit: "cover" }),
  large: directusAssetUrl(item.photo, { width: 1600, quality: 82, format: "webp" }),
  alt: item.alt,
  caption: item.caption,
}));
---

<BaseLayout title="Galeria" description={`Fotos de cultos e eventos da ${siteConfig.name}.`}>
  <SiteHeader posts={allPosts} />
  <main id="content" class="outer">
    <div class="canvas">
      <header class="pagehead">
        <p class="eyebrow">Registros</p>
        <h1 class="pagehead-title">Galeria de fotos</h1>
        <p class="pagehead-description">
          Momentos de cultos, eventos e atividades da igreja.
        </p>
      </header>

      {
        photos.length > 0 ? (
          <ul class="gallery-grid">
            {photos.map((photo, index) => (
              <li class="gallery-item">
                <button type="button" class="gallery-open" data-gallery-open data-index={index} aria-label={`Ampliar foto: ${photo.alt}`}>
                  <img src={photo.src} alt={photo.alt} loading="lazy" />
                </button>
                {photo.caption && <p class="gallery-caption">{photo.caption}</p>}
              </li>
            ))}
          </ul>
        ) : (
          <div class="gallery-empty">
            <p class="text-sm leading-relaxed text-muted-foreground">
              Ainda não há fotos publicadas. Assim que novas fotos de cultos e eventos forem
              adicionadas pelo <a href={DIRECTUS_ADMIN_URL}>painel de conteúdo</a>, elas aparecerão aqui.
            </p>
          </div>
        )
      }

      {
        photos.length > 0 && (
          <dialog class="gallery-lightbox" data-gallery-lightbox aria-label="Foto ampliada">
            <button type="button" class="gallery-lightbox-close" data-gallery-close aria-label="Fechar">✕</button>
            <img data-gallery-lightbox-img alt="" />
            <p class="gallery-lightbox-caption" data-gallery-lightbox-caption></p>
          </dialog>
        )
      }
    </div>
  </main>
  <SiteFooter />
</BaseLayout>

{
  photos.length > 0 && (
    <script is:inline type="application/json" id="gallery-data" set:html={JSON.stringify(photos)} />
  )
}
<script is:inline>
  (() => {
    const dialog = document.querySelector("[data-gallery-lightbox]");
    const img = document.querySelector("[data-gallery-lightbox-img]");
    const captionEl = document.querySelector("[data-gallery-lightbox-caption]");
    const closeBtn = document.querySelector("[data-gallery-close]");
    const openButtons = document.querySelectorAll("[data-gallery-open]");
    const dataEl = document.getElementById("gallery-data");
    if (!dialog || !img || !closeBtn || !dataEl) return;

    const photos = JSON.parse(dataEl.textContent || "[]");

    const abrir = (index) => {
      const photo = photos[index];
      if (!photo) return;
      img.src = photo.large;
      img.alt = photo.alt;
      if (captionEl) captionEl.textContent = photo.caption || "";
      dialog.showModal();
    };

    openButtons.forEach((button) => {
      button.addEventListener("click", () => abrir(Number(button.dataset.index)));
    });

    closeBtn.addEventListener("click", () => dialog.close());
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.addEventListener("close", () => {
      img.src = "";
    });
  })();
</script>

<style>
  .gallery-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  @media (min-width: 640px) {
    .gallery-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .gallery-item {
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
  }

  .gallery-open {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
  }

  .gallery-item img {
    aspect-ratio: 4 / 3;
    width: 100%;
    object-fit: cover;
  }

  .gallery-lightbox {
    max-width: min(90vw, 60rem);
    max-height: 90vh;
    border: 0;
    border-radius: var(--radius-md);
    padding: 0;
    background: var(--background);
    color: var(--foreground);
  }

  .gallery-lightbox::backdrop {
    background: rgb(0 0 0 / 0.75);
  }

  .gallery-lightbox img {
    display: block;
    max-width: 90vw;
    max-height: 80vh;
    object-fit: contain;
  }

  .gallery-lightbox-close {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    background: var(--background);
    color: var(--foreground);
    font-size: 1rem;
    cursor: pointer;
    z-index: 1;
  }

  .gallery-lightbox-caption {
    margin: 0;
    padding: 0.75rem 1rem;
    color: var(--muted-foreground);
    font-size: 0.875rem;
  }

  .gallery-lightbox-caption:empty {
    display: none;
  }

  .gallery-caption {
    padding: 0.6rem 0.8rem;
    color: var(--muted-foreground);
    font-size: 0.8125rem;
  }

  .gallery-empty {
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius-md);
    padding: 2.5rem 1.5rem;
    text-align: center;
  }
</style>
